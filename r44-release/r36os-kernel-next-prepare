#!/bin/bash
set +e
CMD="${1:-arm-once}"
PKGROOT="${R36OS_K1_PACKAGED_ROOT:-/opt/r36os/kernel-next}"
SRC="$PKGROOT/K1"
UPDATE_MOUNT="${R36OS_UPDATE_MOUNT:-/r36update}"
NEXT="${R36OS_KERNEL_NEXT_ROOT:-$UPDATE_MOUNT/R36OS-KernelNext}"
DST="$NEXT/K1"
HOOK="$PKGROOT/hooked-boot.ini"
META_SRC="$PKGROOT/hook.conf"
META="$NEXT/hook.conf"
RESULT=/run/r36os-kernel-next-prepare.result
PROGRESS="${R36OS_K1_PROGRESS_FILE:-/run/r36os-k1-prepare.progress}"
EXPECTED_UPDATE_UUID="${R36OS_EXPECTED_UPDATE_UUID:-C49E-0225}"
STATE_MOUNT="${R36OS_STATE_ROOT:-/r36state}"
EXPECTED_STATE_UUID="${R36OS_EXPECTED_STATE_UUID:-a25488c6-742d-4555-82d1-e28ffc848af3}"
VERSION_HELPER="${R36OS_VERSION_HELPER:-/usr/local/bin/r36os-version}"
PREFLIGHT="${R36OS_K1_PREFLIGHT:-/usr/local/bin/r36os-k1-preflight}"
HOOK_INSTALL="${R36OS_K1_HOOK_INSTALL:-/usr/local/bin/r36os-k1-install-hook}"
SLOT="${R36OS_KERNEL_SLOT_HELPER:-/usr/local/bin/r36os-kernel-slot}"
progress(){ printf '%s|%s|%s|%s\n' "$1" "$2" "$3" "$4" >"$PROGRESS" 2>/dev/null || true; }
fail(){
  progress FAIL 100 "K1 preparation failed" "$2 (code $1)"
  printf 'status=FAIL\ncode=%s\ndetail=%s\n' "$1" "$2" >"$RESULT" 2>/dev/null
  echo "status=FAIL code=$1 detail=$2"
  if command -v r36os-github-diagnostics >/dev/null 2>&1; then
    R36OS_DIAG_FAILURE_CODE="$1" R36OS_DIAG_FAILURE_DETAIL="$2" r36os-github-diagnostics capture "k1-prepare-fail-$1-$2" >/dev/null 2>&1 || true
    r36os-github-diagnostics upload-queued >/dev/null 2>&1 &
  fi
  exit "$1"
}
sha(){ sha256sum "$1" 2>/dev/null | awk '{print $1}'; }
candidate_regular_tree(){
  root="$1"
  [ -d "$root" ] || return 1
  bad="$(find "$root" \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit 2>/dev/null)"
  [ -z "$bad" ]
}
candidate_tree_digest(){
  root="$1"
  (
    cd "$root" || exit 1
    find . -type f -printf '%P\n' 2>/dev/null | LC_ALL=C sort | while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      printf '%s  %s\n' "$(sha256sum "$rel" | awk '{print $1}')" "$rel"
    done
  ) | sha256sum | awk '{print $1}'
}
cleanup_stage(){
  [ -n "${TMP:-}" ] || return 0
  case "$TMP" in "$NEXT"/.K1.stage.*) rm -rf -- "$TMP" 2>/dev/null || true;; esac
}
progress RUNNING 2 "K1 Boot Next Once" "Validating packaged candidate"
val(){ awk -F= -v k="$2" '$1==k{print substr($0,index($0,"=")+1);exit}' "$1" 2>/dev/null; }
[ "$("$VERSION_HELPER" version 2>/dev/null)" = 0.5.44.0 ] || fail 10 wrong-release
"$PREFLIGHT" "$SRC" >/dev/null 2>&1 || fail 11 packaged-candidate-preflight
candidate_regular_tree "$SRC" || fail 27 packaged-candidate-nonregular-entry
SRC_TREE_DIGEST="$(candidate_tree_digest "$SRC")"; [ -n "$SRC_TREE_DIGEST" ] || fail 28 packaged-candidate-tree-digest
progress RUNNING 8 "K1 candidate verified" "Checking R36UPDATE safety"
CID="$(val "$SRC/K1.conf" candidate_id)"; [ -n "$CID" ] || fail 12 candidate-id
[ -s "$HOOK" ] && [ -s "$META_SRC" ] || fail 13 packaged-hook-missing
[ "$(val "$META_SRC" candidate_id)" = "$CID" ] || fail 14 packaged-hook-candidate
# R36UPDATE must be the frozen SD1 update partition, not merely any writable directory.
mountpoint -q "$UPDATE_MOUNT" 2>/dev/null || fail 20 r36update-not-mounted
DEV="$(findmnt -n -o SOURCE "$UPDATE_MOUNT" 2>/dev/null | head -1)"; [ -n "$DEV" ] || fail 21 r36update-source
UUID="$(blkid -s UUID -o value "$DEV" 2>/dev/null | tr 'a-f' 'A-F')"; [ "$UUID" = "$EXPECTED_UPDATE_UUID" ] || fail 22 r36update-uuid
[ -w "$UPDATE_MOUNT" ] || fail 23 r36update-readonly
progress RUNNING 14 "R36UPDATE verified" "Checking FAT health and staging area"
# Refuse only if the FAT warning belongs to the actual mounted R36UPDATE device.
# Earlier R38 code treated a warning from any FAT volume (including BOOT) as R36UPDATE.
DEV_REAL="$(readlink -f "$DEV" 2>/dev/null || printf '%s' "$DEV")"
DEV_BASE="${DEV_REAL##*/}"
FSTYPE="$(findmnt -n -o FSTYPE "$UPDATE_MOUNT" 2>/dev/null | head -1)"
MOPTS="$(findmnt -n -o OPTIONS "$UPDATE_MOUNT" 2>/dev/null | head -1)"
FAT_WARN="$(dmesg 2>/dev/null | grep -F "FAT-fs ($DEV_BASE):" | grep -Ei '(Volume was not properly unmounted|dirty bit|filesystem has been set read-only)' | tail -1)"
{
  echo "mount=$UPDATE_MOUNT"
  echo "source=$DEV_REAL"
  echo "source_basename=$DEV_BASE"
  echo "uuid=$UUID"
  echo "fstype=$FSTYPE"
  echo "options=$MOPTS"
  echo "device_specific_warning=$FAT_WARN"
  echo "all_recent_fat_warnings_begin"
  dmesg 2>/dev/null | grep -Ei 'FAT-fs.*(Volume was not properly unmounted|dirty bit|filesystem has been set read-only)' | tail -20 || true
  echo "all_recent_fat_warnings_end"
} > /run/r36os-r36update-fat-health.conf 2>/dev/null || true
case ",$MOPTS," in *,ro,*) fail 23 r36update-readonly;; esac
if [ -n "$FAT_WARN" ]; then fail 25 "r36update-fat-health-$DEV_BASE"; fi
mkdir -p "$NEXT" || fail 24 next-root-create
progress RUNNING 18 "Checking update space" "Reserving room for the verified K1 candidate"
# A fresh candidate copy needs its full staged size plus 64 MiB FAT headroom.
if [ ! -d "$DST" ]; then
  SRC_KB="$(du -sk "$SRC" 2>/dev/null | awk '{print $1}')"; echo "$SRC_KB" | grep -Eq '^[0-9]+$' || fail 26 r36update-space-measure
  UPDATE_AVAIL_KB="$(df -Pk "$UPDATE_MOUNT" 2>/dev/null | awk 'NR>1{v=$4} END{print v}')"; echo "$UPDATE_AVAIL_KB" | grep -Eq '^[0-9]+$' || fail 26 r36update-space-measure
  UPDATE_NEED_KB=$((SRC_KB + 65536)); [ "$UPDATE_AVAIL_KB" -ge "$UPDATE_NEED_KB" ] || fail 26 r36update-space
fi
progress RUNNING 20 "Staging K1 candidate" "Copying verified Boot Once payload"
# Stage via a fresh sibling directory and never overwrite an unknown/different candidate.
if [ -d "$DST" ]; then
  "$PREFLIGHT" "$DST" >/dev/null 2>&1 || fail 30 existing-candidate-invalid
  [ "$(sha "$DST/MANIFEST.sha256")" = "$(sha "$SRC/MANIFEST.sha256")" ] || fail 31 different-candidate-present
else
  # R36UPDATE is FAT. Do not use cp -a here: preserving Unix ownership/mode
  # metadata on vfat returns EPERM even when every file byte was copied.
  # Copy data into a fresh sibling directory, then verify the exact file tree
  # and K1 manifest before atomically renaming it into the active candidate.
  find "$NEXT" -mindepth 1 -maxdepth 1 -type d -name ".K1.stage.$CID.*" -exec rm -rf -- {} + 2>/dev/null || true
  TMP="$NEXT/.K1.stage.$CID.$"; rm -rf -- "$TMP"; mkdir -p "$TMP" || fail 32 stage-create
  cp -R "$SRC/." "$TMP/" || { cleanup_stage; fail 33 stage-copy; }
  sync
  candidate_regular_tree "$TMP" || { cleanup_stage; fail 36 staged-candidate-nonregular-entry; }
  TMP_TREE_DIGEST="$(candidate_tree_digest "$TMP")"
  [ -n "$TMP_TREE_DIGEST" ] && [ "$TMP_TREE_DIGEST" = "$SRC_TREE_DIGEST" ] || { cleanup_stage; fail 37 staged-candidate-tree-mismatch; }
  "$PREFLIGHT" "$TMP" >/dev/null 2>&1 || { cleanup_stage; fail 34 staged-candidate-preflight; }
  [ "$(sha "$TMP/MANIFEST.sha256")" = "$(sha "$SRC/MANIFEST.sha256")" ] || { cleanup_stage; fail 38 staged-manifest-readback; }
  mv "$TMP" "$DST" || { cleanup_stage; fail 35 stage-rename; }
  TMP=""
  sync
  "$PREFLIGHT" "$DST" >/dev/null 2>&1 || fail 39 activated-candidate-preflight
  [ "$(candidate_tree_digest "$DST")" = "$SRC_TREE_DIGEST" ] || fail 43 activated-candidate-tree-mismatch
fi
# Candidate-bound metadata can be installed before the hook; it cannot affect boot by itself.
cp -f "$META_SRC" "$META.tmp" || fail 40 hook-meta-copy
sync "$META.tmp" 2>/dev/null || sync
mv -f "$META.tmp" "$META" || fail 41 hook-meta-activate
[ "$(sha "$META")" = "$(sha "$META_SRC")" ] || fail 42 hook-meta-readback
if [ "$CMD" = stage-only ]; then
  progress PASS 100 "K1 candidate staged" "Legacy boot remains unchanged"
  printf 'status=PASS\ncode=0\ndetail=candidate-staged\ncandidate_id=%s\n' "$CID" >"$RESULT"; echo "status=PASS candidate_id=$CID result=STAGED"; exit 0
fi
[ "$CMD" = arm-once ] || fail 2 usage
progress RUNNING 32 "Checking R36STATE" "Verifying module storage partition"
# The K1 module tree is staged on expanded R36STATE, never over legacy 4.4 modules.
mountpoint -q "$STATE_MOUNT" 2>/dev/null || fail 60 r36state-not-mounted
SDEV="$(findmnt -n -o SOURCE "$STATE_MOUNT" 2>/dev/null | head -1)"; [ -n "$SDEV" ] || fail 61 r36state-source
SUUID="$(blkid -s UUID -o value "$SDEV" 2>/dev/null | tr 'A-F' 'a-f')"; [ "$SUUID" = "$EXPECTED_STATE_UUID" ] || fail 62 r36state-uuid
[ -w "$STATE_MOUNT" ] || fail 63 r36state-readonly
KREL="$(val "$DST/K1.conf" kernel_release)"; CID="$(val "$DST/K1.conf" candidate_id)"
MODROOTNAME="$(val "$DST/K1.conf" modules_archive_root)"; [ "$MODROOTNAME" = "modules-$KREL" ] || fail 64 modules-root
MODBYTES="$(val "$DST/K1.conf" modules_uncompressed_bytes)"; echo "$MODBYTES" | grep -Eq '^[0-9]+$' || fail 65 modules-bytes
MODFILES="$(val "$DST/K1.conf" modules_file_count)"; echo "$MODFILES" | grep -Eq '^[0-9]+$' || fail 66 modules-files
MODBASE="$STATE_MOUNT/kernel-next/modules"; MODDST="$MODBASE/$KREL"; MODMETA="$MODDST/.r36os-k1-candidate"
verify_modules(){
  [ -d "$MODDST" ] || return 1
  [ ! -L "$MODDST" ] || return 1
  [ -s "$MODDST/modules.dep" ] || return 1
  [ -s "$MODMETA" ] || return 1
  [ "$(val "$MODMETA" candidate_id)" = "$CID" ] || return 1
  [ "$(val "$MODMETA" kernel_release)" = "$KREL" ] || return 1
  [ "$(val "$MODMETA" archive_sha256)" = "$(sha "$DST/modules.tar.xz")" ] || return 1
  [ "$(find "$MODDST" -type l -print -quit 2>/dev/null)" = "" ] || return 1
  FC="$(find "$MODDST" -type f ! -name .r36os-k1-candidate | wc -l | tr -d ' ')"; [ "$FC" = "$MODFILES" ] || return 1
  BY="$(find "$MODDST" -type f ! -name .r36os-k1-candidate -printf '%s\n' | awk '{s+=$1} END{printf "%.0f",s}')"; [ "$BY" = "$MODBYTES" ] || return 1
  return 0
}
if [ -e "$MODDST" ]; then
  progress RUNNING 54 "Checking existing K1 modules" "Reusing candidate-bound module tree when valid"
  verify_modules || fail 67 existing-modules-invalid
  progress RUNNING 82 "K1 modules ready" "Existing module tree verified"
else
  progress RUNNING 38 "Checking R36STATE space" "Reserving module tree plus 256 MiB safety headroom"
  STATE_AVAIL_KB="$(df -Pk "$STATE_MOUNT" 2>/dev/null | awk 'NR>1{v=$4} END{print v}')"; echo "$STATE_AVAIL_KB" | grep -Eq '^[0-9]+$' || fail 82 r36state-space-measure
  MODULE_NEED_KB=$(((MODBYTES + 1023) / 1024 + 262144)); [ "$STATE_AVAIL_KB" -ge "$MODULE_NEED_KB" ] || fail 82 r36state-space
  progress RUNNING 42 "Preparing K1 modules" "Validating module archive before extraction"
  mkdir -p "$MODBASE" || fail 68 modules-root-create
  TMPM="$MODBASE/.stage-$CID-$$"; rm -rf "$TMPM"; mkdir -p "$TMPM" || fail 69 modules-stage-create
  # Authenticated archive is already covered by K1 MANIFEST; reject unsafe paths/links before extraction.
  tar -tJf "$DST/modules.tar.xz" >/run/r36os-k1-modules-list.$$ 2>/dev/null || { rm -rf "$TMPM"; fail 70 modules-list; }
  if grep -Eq '(^/|(^|/)\.\.(/|$))' /run/r36os-k1-modules-list.$$; then rm -rf "$TMPM" /run/r36os-k1-modules-list.$$; fail 71 modules-path; fi
  if tar -tvJf "$DST/modules.tar.xz" 2>/dev/null | awk 'substr($1,1,1)=="l" || substr($1,1,1)=="h" {bad=1} END{exit bad?0:1}'; then rm -rf "$TMPM" /run/r36os-k1-modules-list.$$; fail 72 modules-link; fi
  rm -f /run/r36os-k1-modules-list.$$
  progress RUNNING 52 "Extracting K1 modules" "First preparation may take several minutes"
  tar -xJf "$DST/modules.tar.xz" -C "$TMPM" >/dev/null 2>&1 || { rm -rf "$TMPM"; fail 73 modules-extract; }
  progress RUNNING 72 "Verifying extracted modules" "Checking file count, size and modules.dep"
  [ -d "$TMPM/$MODROOTNAME" ] || { rm -rf "$TMPM"; fail 74 modules-extracted-root; }
  [ "$(find "$TMPM/$MODROOTNAME" -type l -print -quit 2>/dev/null)" = "" ] || { rm -rf "$TMPM"; fail 75 modules-extracted-link; }
  FC="$(find "$TMPM/$MODROOTNAME" -type f | wc -l | tr -d ' ')"; [ "$FC" = "$MODFILES" ] || { rm -rf "$TMPM"; fail 76 modules-file-count; }
  BY="$(find "$TMPM/$MODROOTNAME" -type f -printf '%s\n' | awk '{s+=$1} END{printf "%.0f",s}')"; [ "$BY" = "$MODBYTES" ] || { rm -rf "$TMPM"; fail 77 modules-byte-count; }
  [ -s "$TMPM/$MODROOTNAME/modules.dep" ] || { rm -rf "$TMPM"; fail 78 modules-dep; }
  {
    echo 'format=R36OS_K1_MODULES_V1'
    echo "candidate_id=$CID"
    echo "kernel_release=$KREL"
    echo "archive_sha256=$(sha "$DST/modules.tar.xz")"
    echo "file_count=$MODFILES"
    echo "uncompressed_bytes=$MODBYTES"
  } > "$TMPM/$MODROOTNAME/.r36os-k1-candidate" || { rm -rf "$TMPM"; fail 79 modules-meta; }
  sync
  mv "$TMPM/$MODROOTNAME" "$MODDST" || { rm -rf "$TMPM"; fail 80 modules-activate; }
  rmdir "$TMPM" 2>/dev/null || true
  sync
  verify_modules || fail 81 modules-readback
  progress RUNNING 82 "K1 modules ready" "R36STATE module tree verified"
fi
# This is the first boot-affecting operation and happens only after explicit user action.
progress RUNNING 88 "Installing one-shot boot guard" "Preserving exact legacy boot recovery copy"
"$HOOK_INSTALL" "$HOOK" "$META" >/run/r36os-k1-hook-install.result 2>&1 || fail 50 hook-install
progress RUNNING 95 "Arming next boot only" "Writing candidate-bound one-shot request"
"$SLOT" arm-once >/run/r36os-k1-arm.result 2>&1 || fail 51 arm-once
sync
progress PASS 100 "K1 Boot Next Once armed" "Restart to test; later boot falls back to legacy"
printf 'status=PASS\ncode=0\ndetail=armed-once\ncandidate_id=%s\n' "$CID" >"$RESULT"
echo "status=PASS candidate_id=$CID result=ARMED_ONCE"
exit 0
