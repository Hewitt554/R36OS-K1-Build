#!/bin/bash
set +e

# Legacy 4.4 must remain behaviorally equivalent: immediately replace this
# wrapper with the existing R36OS session.  Environment overrides are test-only;
# device defaults remain the real /proc cmdline and installed session.
CMDLINE_FILE="${R36OS_CMDLINE_FILE:-/proc/cmdline}"
SESSION_BIN="${R36OS_SESSION_BIN:-/usr/local/bin/r36os-session}"
COMPAT_BIN="${R36OS_K1_INPUT_COMPAT_BIN:-/usr/local/bin/r36os-k1-input-compat}"
SNAPSHOT_BIN="${R36OS_K1_SNAPSHOT_BIN:-/usr/local/bin/r36os-k1-hardware-snapshot}"
if ! grep -q 'r36os.kernel_slot=next' "$CMDLINE_FILE" 2>/dev/null; then
  exec "$SESSION_BIN" "$@"
fi

CID='4c70486f70ba16acf7437403'
rm -f /run/r36os-k1-input-compat.ready /run/r36os-k1-input-compat.status

# Persist the physical Linux 6.12 input/power topology before adding compatibility.
if [ -x "$SNAPSHOT_BIN" ]; then
  "$SNAPSHOT_BIN" >/dev/null 2>&1 || true
fi

# K1 may expose the controls as one renamed evdev device or as separate
# axis/button devices. The compatibility process discovers them by evdev
# capabilities and presents one stable virtual event named R36OS K1 Gamepad.
modprobe uinput >/dev/null 2>&1 || true
"$COMPAT_BIN" >/dev/null 2>&1 &
BRIDGEPID=$!

for i in $(seq 1 100); do
  [ -s /run/r36os-k1-input-compat.ready ] && break
  kill -0 "$BRIDGEPID" 2>/dev/null || break
  sleep 0.1
done

# Snapshot again after the bridge attempt so logs show both physical and virtual
# input devices and the exact compatibility status.
if [ -x /usr/local/bin/r36os-k1-hardware-snapshot ]; then
  /usr/local/bin/r36os-k1-hardware-snapshot >/dev/null 2>&1 || true
fi

"$SESSION_BIN" "$@"
RC=$?

kill "$BRIDGEPID" 2>/dev/null || true
wait "$BRIDGEPID" 2>/dev/null || true

# On K1, do not fall back to an ambiguous white underscore after a UI failure.
# Keep the final evidence on tty1 until the user deliberately power-cycles.
if [ "$RC" -ne 0 ]; then
  if command -v plymouth >/dev/null 2>&1; then
    plymouth quit >/dev/null 2>&1 || plymouth --quit >/dev/null 2>&1 || true
  fi
  {
    printf '\033[?25l\033[2J\033[H'
    printf 'R36OS K1 UI stopped before a healthy first frame.\n\n'
    printf 'Kernel: %s\n' "$(uname -r 2>/dev/null)"
    printf 'UI state: %s\n' "$(tr '\n' ' ' </run/r36os-alpha5-state 2>/dev/null)"
    printf 'Input compatibility: %s\n\n' "$(tr '\n' ' ' </run/r36os-k1-input-compat.status 2>/dev/null)"
    printf 'Input devices:\n'
    awk '/^N: Name=/{print "  " $0}' /proc/bus/input/devices 2>/dev/null
    printf '\nEvidence saved in R36STATE.\nPower-cycle once to return to the legacy kernel.\n'
  } >/dev/tty1 2>/dev/null || true
  while :; do sleep 3600; done
fi

exit "$RC"
