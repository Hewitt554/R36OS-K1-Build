#!/bin/bash
# R36OS Alpha 5R39 candidate-specific Kernel Next slot manager.
set +e
CMD="${1:-status}"
NEXT="${R36OS_KERNEL_NEXT_ROOT:-/r36update/R36OS-KernelNext}"
K1="$NEXT/K1"; REQ=""; CONSUMED=""
BOOT="${R36OS_LEGACY_BOOT:-/boot/boot.ini}"; META="${R36OS_K1_HOOK_META:-$NEXT/hook.conf}"
UNLOCK="${R36OS_CP08_UNLOCK:-1}"
VERSION_HELPER="${R36OS_VERSION_HELPER:-/usr/local/bin/r36os-version}"
PREFLIGHT="${R36OS_K1_PREFLIGHT:-/usr/local/bin/r36os-k1-preflight}"
sha(){ sha256sum "$1" 2>/dev/null | awk '{print $1}'; }
val(){ awk -F= -v k="$2" '$1==k{print substr($0,index($0,"=")+1);exit}' "$1" 2>/dev/null; }
marker_paths(){ [ -n "${CID:-}" ] || return 1; REQ="$NEXT/boot-next.$CID.once"; CONSUMED="$NEXT/boot-next.$CID.consumed"; }
verify_candidate(){
  [ "$("$VERSION_HELPER" version 2>/dev/null)" = 0.5.39.0 ] || return 19
  "$PREFLIGHT" "$K1" >/dev/null 2>&1 || return $?
  [ -d "$K1" ] || return 20
  for f in Image uInitrd rk3326-r36s-k1.dtb modules.tar.xz K1.conf BUILD_INFO.txt MANIFEST.sha256; do [ -s "$K1/$f" ] || return 21; done
  (cd "$K1" && sha256sum -c MANIFEST.sha256 >/dev/null 2>&1) || return 22
  [ "$(val "$K1/K1.conf" hardware)" = R36XX-RK3326 ] || return 23
  [ "$(val "$K1/K1.conf" panel)" = PANEL4_NV3051D_640X480 ] || return 24
  [ "$(val "$K1/K1.conf" root_uuid)" = e139ce78-9841-40fe-8823-96a304a09859 ] || return 25
  [ "$(val "$K1/K1.conf" boot_mode)" = R36OS_K1_BOOT_ONCE ] || return 26
  CID="$(val "$K1/K1.conf" candidate_id)"; echo "$CID" | grep -Eq '^[0-9a-f]{24}$' || return 29
  marker_paths || return 30
}
verify_hook(){
  [ -s "$META" ] && [ -s "$BOOT" ] || return 40
  verify_candidate || return $?
  [ "$(val "$META" candidate_id)" = "$CID" ] || return 41
  H="$(val "$META" hooked_boot_sha256)"; [ -n "$H" ] || return 42
  [ "$(sha "$BOOT")" = "$H" ] || return 43
  grep -qF '# R36OS-K1-BOOT-ONCE-HOOK' "$BOOT" || return 44
  grep -qF "# candidate_id=$CID" "$BOOT" || return 45
}
arm(){
  [ "$UNLOCK" = 1 ] || { echo 'status=FAIL code=95 detail=r39-runtime-lock'; return 95; }
  verify_hook || { R=$?; echo "status=FAIL code=$R detail=verification"; return "$R"; }
  mkdir -p "$NEXT" || return 60
  rm -f "$CONSUMED" "$REQ.tmp"; sync
  [ ! -e "$CONSUMED" ] || return 61
  MID="$(sha "$K1/MANIFEST.sha256")"
  { echo 'format=R36OS_K1_BOOT_REQUEST_V1'; echo "candidate_id=$CID"; echo "candidate_manifest_sha256=$MID"; } >"$REQ.tmp" || return 62
  sync; mv -f "$REQ.tmp" "$REQ" || return 63; sync
  [ "$(val "$REQ" candidate_id)" = "$CID" ] || return 64
  [ "$(val "$REQ" candidate_manifest_sha256)" = "$MID" ] || return 65
  echo "status=PASS candidate_id=$CID"
}
disarm(){
  verify_candidate >/dev/null 2>&1
  [ $? -eq 0 ] && rm -f "$REQ" "$CONSUMED" "$REQ.tmp"
  rm -f "$NEXT/boot-next.once" "$NEXT/boot-next.consumed" "$NEXT/boot-next.once.tmp"
  sync; echo status=PASS
}
status(){
  verify_candidate; V=$?; verify_hook; H=$?
  echo "candidate_verify_code=$V"; echo "hook_verify_code=$H"
  if [ -n "$REQ" ]; then
    echo "request_path=$REQ"; echo "consumed_path=$CONSUMED"
    echo "armed=$([ -s "$REQ" ]&&echo yes||echo no)"; echo "consumed=$([ -s "$CONSUMED" ]&&echo yes||echo no)"
  else echo "armed=no"; echo "consumed=no"; fi
}
case "$CMD" in status) status;; arm-once) arm;; disarm) disarm;; *) echo 'usage: status|arm-once|disarm' >&2; exit 2;; esac
