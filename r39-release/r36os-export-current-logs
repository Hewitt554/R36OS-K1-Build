#!/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
# R36OS current-build diagnostics exporter: create + verify on visible SD before success.
set +e
WHY="${1:-manual}"
RESULT=/run/r36os-export.result
PROGRESS=/run/r36os-export.progress
PERSIST_DIR=/r36state/logs/export; PERSIST_RESULT="$PERSIST_DIR/LAST.conf"; mkdir -p "$PERSIST_DIR" 2>/dev/null || true; rm -f "$RESULT" "$PROGRESS" 2>/dev/null || true
progress(){ printf '%s|%s|%s|%s\n' "$1" "$2" "$3" "$4" >"$PROGRESS" 2>/dev/null || true; }
friendly_dest(){ case "$1" in /boot/R36OS-Logs/*|/boot/R36OS-Logs) printf 'BOOT/R36OS-Logs\n';; /boot/update/R36OS-Logs/*|/boot/update/R36OS-Logs) printf 'BOOT/update/R36OS-Logs\n';; /r36update/R36OS-Logs/*|/r36update/R36OS-Logs) printf 'R36UPDATE/R36OS-Logs\n';; /r36update/update/R36OS-Logs/*|/r36update/update/R36OS-Logs) printf 'R36UPDATE/update/R36OS-Logs\n';; /roms2/r36os/logs/*|/roms2/r36os/logs) printf 'SD2/r36os/logs\n';; *) printf '%s\n' "$1";; esac; }
mounted_for_dest(){ case "$1" in /boot/*) mountpoint -q /boot 2>/dev/null;; /r36update/*) mountpoint -q /r36update 2>/dev/null;; /roms2/*) mountpoint -q /roms2 2>/dev/null;; *) return 1;; esac; }
ensure_writable_dest(){ D="$1"; mounted_for_dest "$D" || return 1; mkdir -p "$D" 2>/dev/null || return 1; P="$D/.r36os-write-test.$$"; printf 'ok\n' >"$P" 2>/dev/null || return 1; rm -f "$P" 2>/dev/null || true; return 0; }
write_status(){ ST="$1"; CODE="$2"; DETAIL="$3"; ARC="${4:-}"; DEST="${5:-}"; BYTES="${6:-0}"; SHA="${7:-}"; FRIENDLY="$(friendly_dest "$DEST")"; { echo "status=$ST"; echo "code=$CODE"; echo "detail=$DETAIL"; echo "requested_export=$WHY"; echo "archive=$ARC"; echo "destination=$DEST"; echo "visible_location=$FRIENDLY"; echo "bytes=$BYTES"; echo "sha256=$SHA"; echo "time=$(date -Is 2>/dev/null || date)"; } >"$RESULT" 2>/dev/null || true; cp -f "$RESULT" "$PERSIST_RESULT" 2>/dev/null || true; }
mirror_error(){ MSG="$1"; for D in /boot/R36OS-Logs /boot/update/R36OS-Logs /r36update/R36OS-Logs /r36update/update/R36OS-Logs /roms2/r36os/logs; do ensure_writable_dest "$D" || continue; { echo "R36OS LOG EXPORT FAILED"; echo "time=$(date -Is 2>/dev/null || date)"; echo "reason=$MSG"; echo "requested_export=$WHY"; echo "release_file:"; cat /etc/r36os-release 2>/dev/null || true; echo "storage:"; df -hT /boot /r36update /r36state /roms2 2>/dev/null || true; } >"$D/R36OS-LOG-EXPORT-ERROR.txt" 2>/dev/null || true; done; }
fail_export(){ CODE="$1"; DETAIL="$2"; progress FAIL 100 "Export failed" "$DETAIL"; write_status FAIL "$CODE" "$DETAIL"; mirror_error "$DETAIL"; exit "$CODE"; }
progress RUNNING 3 "Starting diagnostics export" "Finding the current R36OS session"
LOCALDIR="$(cat /run/r36os-alpha5-logdir 2>/dev/null)"
if [ -z "$LOCALDIR" ] || [ ! -d "$LOCALDIR" ]; then LOCALDIR="$(find /r36state/logs -maxdepth 1 -type d -name 'alpha5r*-*' -printf '%T@|%p\n' 2>/dev/null | sort -nr | head -1 | cut -d'|' -f2-)"; fi
[ -n "$LOCALDIR" ] && [ -d "$LOCALDIR" ] || fail_export 72 no-session-log-directory
progress RUNNING 8 "Session located" "Checking R36OS release identity"
SESSION="$(basename "$LOCALDIR")"; SESSION_STAMP="${SESSION#*-}"; [ "$SESSION_STAMP" != "$SESSION" ] || SESSION_STAMP="not-session-named"
RELEASE_TAG="$(/usr/local/bin/r36os-version tag 2>/dev/null)" || fail_export 70 release-identity-failed
progress RUNNING 14 "Release verified" "Finding the user-visible SD1 log folder"
EXPORT_STAMP="$(date +%Y%m%d-%H%M%S 2>/dev/null)"; case "$EXPORT_STAMP" in ????????-??????) ;; *) fail_export 71 invalid-export-time;; esac
ARCHIVE="R36OS-${RELEASE_TAG}-results-${EXPORT_STAMP}.tar.gz"
PRIMARY=""; for D in /boot/R36OS-Logs /boot/update/R36OS-Logs /r36update/R36OS-Logs /r36update/update/R36OS-Logs /roms2/r36os/logs; do if ensure_writable_dest "$D"; then PRIMARY="$D"; break; fi; done
[ -n "$PRIMARY" ] || fail_export 73 no-writable-diagnostic-destination
progress RUNNING 20 "Collecting system state" "Gathering R36OS, storage, controller and runtime details"
{
 echo "export_reason=$WHY"
 echo "export_time=$(date -Is 2>/dev/null || date)"
 echo "export_stamp=$EXPORT_STAMP"
 echo "session=$SESSION"
 echo "session_start_stamp=$SESSION_STAMP"
 echo "release_tag=$RELEASE_TAG"
 echo "ui_version=$(cat /run/r36os-ui-version 2>/dev/null | tr '\n' ' ')"
 echo "ui_state=$(cat /run/r36os-alpha5-state 2>/dev/null | tr '\n' ' ')"
 echo "update_status=$(cat /run/r36os-update-status 2>/dev/null | tr '\n' ' ')"
 echo "update_result=$(cat /run/r36os-update-result 2>/dev/null | tr '\n' ' ')"
 echo "wine_test_result=$(cat /run/r36os-wine-test.result 2>/dev/null | tr '\n' ' ')"
 echo "driver_result=$(cat /run/r36os-driver-result 2>/dev/null | tr '\n' ' ')"
 echo "dependency_status=$(cat /run/r36os-dependency-status 2>/dev/null | tr '\n' ';')"
 echo "dependency_result=$(cat /run/r36os-dependency-result 2>/dev/null | tr '\n' ' ')"
 echo "windows_runtime_current=$(cat /r36state/runtimes/windows/CURRENT 2>/dev/null | tr '\n' ' ')"
 echo "windows_runtime_version=$(cat /r36state/runtimes/windows/CURRENT_VERSION 2>/dev/null | tr '\n' ' ')"
 CACHE=/r36update/R36OS-Cache/Windows/r36s-v1.0/headoverheels-r36s.zip
 if [ -s "$CACHE" ]; then
   echo "windows_cache_path=$CACHE"
   echo "windows_cache_bytes=$(stat -c %s "$CACHE" 2>/dev/null)"
   echo "windows_cache_sha256=$(sha256sum "$CACHE" 2>/dev/null | awk '{print $1}')"
   echo "windows_cache_info=$(cat "$CACHE.cache-info" 2>/dev/null | tr '\n' ';')"
 else
   echo "windows_cache_path=missing_or_unmounted"
 fi
 DXCACHE=/r36update/R36OS-Cache/Dependencies/directx-jun2010/directx_Jun2010_redist.exe
 [ -s "$DXCACHE" ] || DXCACHE=/r36state/cache/dependencies/directx-jun2010/directx_Jun2010_redist.exe
 if [ -s "$DXCACHE" ]; then
   echo "directx_cache_path=$DXCACHE"
   echo "directx_cache_bytes=$(stat -c %s "$DXCACHE" 2>/dev/null)"
   echo "directx_cache_sha256=$(sha256sum "$DXCACHE" 2>/dev/null | awk '{print $1}')"
   echo "directx_cache_info=$(cat "$DXCACHE.cache-info" 2>/dev/null | tr '\n' ';')"
 else
   echo "directx_cache_path=missing_or_unmounted"
 fi
 DXPACK=/r36state/dependencies/directx-jun2010-d3d43/2010.06
 echo "directx_pack_prepared=$([ -f "$DXPACK/.prepared" ] && echo yes || echo no)"
 [ -f "$DXPACK/checksums.sha256" ] && echo "directx_pack_checksums=$(cat "$DXPACK/checksums.sha256" 2>/dev/null | tr '\n' ';')"
 EXP=/r36update/R36OS-Cache/Dependencies/directx-jun2010/expanded
 [ -d "$EXP" ] && echo "directx_expanded_files=$(find "$EXP" -maxdepth 2 -type f -printf '%f,' 2>/dev/null | head -c 1500)"
 WR="$(cat /r36state/runtimes/windows/CURRENT 2>/dev/null)"
 [ -n "$WR" ] && echo "windows_runtime_validated=$(cat "$WR/validated.conf" 2>/dev/null | tr '\n' ';')"
 echo "game_scan_result=$(cat /run/r36os-game-scan.result 2>/dev/null | tr '\n' ' ')"
 echo "game_launch_result=$(cat /run/r36os-game-launch.result 2>/dev/null | tr '\n' ' ')"
 echo "boot_branding_status=$(/usr/local/bin/r36os-boot-branding status 2>/dev/null || echo ERROR)"
 echo "boot_branding_result=$(cat /run/r36os-initramfs-branding.result 2>/dev/null | tr '\n' ';')"
 echo "boot_progress=$(cat /run/r36os-boot-progress 2>/dev/null | tr '\n' ';')"
 echo "sd1_mount_r36update=$(mountpoint -q /r36update && echo yes || echo no)"
 echo "sd1_mount_boot=$(mountpoint -q /boot && echo yes || echo no)"
 echo "sd2_mount=$(mountpoint -q /roms2 && echo yes || echo no)"
 echo "--- mounts ---"; cat /proc/mounts 2>/dev/null || true
 echo "--- block labels ---"; blkid 2>/dev/null || true
 echo "--- driver status ---"; cat /run/r36os-driver-status 2>/dev/null || true
 echo "--- dependency status ---"; cat /run/r36os-dependency-status 2>/dev/null || true
 echo "--- Drop & Play catalog ---"; cat /run/r36os-manual-games.tsv 2>/dev/null || true
 echo "--- release ---"; cat /etc/r36os-release 2>/dev/null || true
 echo "--- power ownership policy ---"; cat /etc/systemd/logind.conf.d/90-r36os-power.conf 2>/dev/null || true
 echo "--- pending update ---"; cat /r36state/update/pending.conf 2>/dev/null || true
 echo "--- swaps ---"; cat /proc/swaps 2>/dev/null || true
 echo "--- battery fuel gauge ---"; /usr/local/bin/r36os-battery-snapshot export >/dev/null 2>&1 || true; cat /run/r36os-battery-status 2>/dev/null || true
 echo "--- R26 resource policy ---"; /usr/local/bin/r36os-resource-ctl status 2>/dev/null || true
 echo "--- controller policy/inventory ---"; /usr/local/bin/r36os-controller-manager inventory 2>/dev/null || true; cat /run/r36os-controller-report.txt 2>/dev/null || true
 echo "--- audio policy ---"; /usr/local/bin/r36os-audio-manager status 2>/dev/null || true
 echo "--- steam lightweight policy ---"; /usr/local/bin/r36os-steam-manager status 2>/dev/null || true
 echo "--- remote support ---"; /usr/local/bin/r36os-remote-support status 2>/dev/null || true
 echo "--- graphics slots ---"; /usr/local/bin/r36os-graphics-slot status 2>/dev/null || true
 echo "--- kernel lab ---"; /usr/local/bin/r36os-kernel-lab status 2>/dev/null || true
 echo "--- kernel next slot ---"; /usr/local/bin/r36os-kernel-slot status 2>/dev/null || true
 echo "--- SD1 capacity reclaim ---"; /usr/local/bin/r36os-state-expand status 2>/dev/null || true
 echo "--- runner registry ---"; /usr/local/bin/r36os-runner-manager list wine 2>/dev/null || true; /usr/local/bin/r36os-runner-manager list box64 2>/dev/null || true; /usr/local/bin/r36os-runner-manager list weston 2>/dev/null || true
 echo "--- regression boot check ---"; /usr/local/bin/r36os-regression-selftest boot 2>/dev/null || true
 for u in r36os NetworkManager emulationstation play-video networkwatchdaemon r36os-zram r36os-health-watchdog r36os-usb-tune; do
   printf '%s enabled=' "$u"; systemctl is-enabled "$u.service" 2>/dev/null || true
   printf '%s active=' "$u"; systemctl is-active "$u.service" 2>/dev/null || true
 done
} >"$LOCALDIR/export-summary.txt" 2>&1
progress RUNNING 34 "Collecting system logs" "Capturing kernel, service, storage and input evidence"
(dmesg >"$LOCALDIR/dmesg-export.txt" 2>&1 || true)
(systemctl --failed --no-pager >"$LOCALDIR/systemd-failed.txt" 2>&1 || true)
(df -hT >"$LOCALDIR/storage-export.txt" 2>&1 || true)
if command -v lsusb >/dev/null 2>&1; then
  (lsusb -t >"$LOCALDIR/usb-tree-export.txt" 2>&1 || true); (lsusb >>"$LOCALDIR/usb-tree-export.txt" 2>&1 || true)
else
  { echo 'lsusb=unavailable'; echo 'fallback=sysfs'; for d in /sys/bus/usb/devices/*; do [ -d "$d" ] || continue; printf 'device=%s vendor=%s product=%s name=%s\n' "$(basename "$d")" "$(cat "$d/idVendor" 2>/dev/null)" "$(cat "$d/idProduct" 2>/dev/null)" "$(cat "$d/product" 2>/dev/null)"; done; } >"$LOCALDIR/usb-tree-export.txt"
fi
(cat /proc/bus/input/devices >"$LOCALDIR/input-devices.txt" 2>&1 || true)
(cp -f /r36state/logs/dependencies/dependency-manager.log "$LOCALDIR/dependency-manager.log" 2>/dev/null || true)
# Always attach the newest game session, even if this bundle was triggered later by
# session-start/shutdown. This prevents the failure evidence from being hidden.
GSDIR="$(cat /run/r36os-current-game-session 2>/dev/null)"
[ -d "$GSDIR" ] || GSDIR="$(cat /r36state/logs/game-sessions/LATEST 2>/dev/null)"
if [ ! -d "$GSDIR" ]; then
  GCONF="$(find /r36state/logs/game-sessions -mindepth 3 -maxdepth 3 -name session.conf -type f -printf '%T@|%p\n' 2>/dev/null | sort -nr | head -1 | cut -d'|' -f2-)"
  [ -n "$GCONF" ] && GSDIR="$(dirname "$GCONF")"
fi
if [ -d "$GSDIR" ]; then
  rm -rf "$LOCALDIR/latest-game-session" 2>/dev/null || true
  cp -a "$GSDIR" "$LOCALDIR/latest-game-session" 2>/dev/null || true
  printf 'latest_game_session=%s\n' "$GSDIR" >>"$LOCALDIR/export-summary.txt" 2>/dev/null || true
fi
cp -f /run/r36os-game-session.progress "$LOCALDIR/game-session-progress.txt" 2>/dev/null || true
cp -f /run/r36os-game-launch.result "$LOCALDIR/game-launch-result.txt" 2>/dev/null || true
cp -f /run/r36os-controller-report.txt "$LOCALDIR/controller-report.txt" 2>/dev/null || true
cp -f /run/r36os-resource/status.conf "$LOCALDIR/resource-status.txt" 2>/dev/null || true
cp -f /r36state/logs/r36os-boot-branding.log "$LOCALDIR/boot-branding.log" 2>/dev/null || true
cp -f /run/r36os-initramfs-branding.result "$LOCALDIR/boot-branding-result.txt" 2>/dev/null || true
cp -f /run/r36os-boot-progress "$LOCALDIR/boot-progress.txt" 2>/dev/null || true
cp -f /r36state/logs/r36os-resource.log "$LOCALDIR/resource-daemon.log" 2>/dev/null || true
/usr/local/bin/r36os-benchmark-suite latest >"$LOCALDIR/benchmark-suite-latest.txt" 2>&1 || true
progress RUNNING 46 "Running diagnostic checks" "Capturing regression and graphics capability evidence"
case "$WHY" in diagnostics-manual|manual|support)
  /usr/local/bin/r36os-regression-selftest full >"$LOCALDIR/regression-selftest.txt" 2>&1 || true
  /usr/local/bin/r36os-panfrost-selftest >"$LOCALDIR/panfrost-capabilities.txt" 2>&1 || true;;
*) /usr/local/bin/r36os-regression-selftest boot >"$LOCALDIR/regression-selftest.txt" 2>&1 || true;;
esac
/usr/local/bin/r36os-graphics-slot status >"$LOCALDIR/graphics-slots.txt" 2>&1 || true
/usr/local/bin/r36os-core-integrity export >"$LOCALDIR/core-integrity.txt" 2>&1 || true
[ -f /r36state/logs/graphics-test/LAST.conf ] && cp -f /r36state/logs/graphics-test/LAST.conf "$LOCALDIR/graphics-test-latest.conf" 2>/dev/null || true
GTL="$(cat /r36state/logs/graphics-test/LATEST 2>/dev/null)"; [ -d "$GTL" ] && { rm -rf "$LOCALDIR/latest-graphics-test" 2>/dev/null || true; cp -a "$GTL" "$LOCALDIR/latest-graphics-test" 2>/dev/null || true; }
/usr/local/bin/r36os-runner-manager status >"$LOCALDIR/wine-runners.txt" 2>&1 || true
/usr/local/bin/r36os-remote-support status >"$LOCALDIR/remote-support.txt" 2>&1 || true
mkdir -p "$LOCALDIR/persistent-power" 2>/dev/null || true
cp -f /r36state/logs/power/last-request.conf "$LOCALDIR/persistent-power/last-request.conf" 2>/dev/null || true
cp -f /r36state/logs/power/last-result.conf "$LOCALDIR/persistent-power/last-result.conf" 2>/dev/null || true
cp -f /r36state/logs/power/watchdog-last.conf "$LOCALDIR/persistent-power/watchdog-last.conf" 2>/dev/null || true
cp -f /r36state/logs/power/watchdog.log "$LOCALDIR/persistent-power/watchdog.log" 2>/dev/null || true
cp -f /r36state/logs/power/power-action.log "$LOCALDIR/persistent-power/power-action.log" 2>/dev/null || true
cp -f /run/r36os-power-action.result "$LOCALDIR/power-action-result.txt" 2>/dev/null || true
cp -f /r36state/logs/power/last-snapshot.conf "$LOCALDIR/persistent-power/last-snapshot.conf" 2>/dev/null || true
cp -f /r36state/logs/power/last-shutdown-marker.conf "$LOCALDIR/persistent-power/last-shutdown-marker.conf" 2>/dev/null || true
cp -f /run/r36os-power-previous.conf "$LOCALDIR/persistent-power/previous-shutdown.conf" 2>/dev/null || true
cp -f /run/r36os-space-maintenance.conf "$LOCALDIR/space-maintenance.txt" 2>/dev/null || true
cp -f /run/r36os-kernel-lab.status "$LOCALDIR/kernel-lab-status.txt" 2>/dev/null || true
cp -f /run/r36os-kernel-lab.result "$LOCALDIR/kernel-lab-result.txt" 2>/dev/null || true
cp -f /r36update/R36OS-KernelLab/LATEST.conf "$LOCALDIR/kernel-lab-latest.conf" 2>/dev/null || true
cp -f /run/r36os-kernel-slot.status "$LOCALDIR/kernel-slot-status.txt" 2>/dev/null || true
cp -f /run/r36os-kernel-slot.result "$LOCALDIR/kernel-slot-result.txt" 2>/dev/null || true
cp -f /run/r36os-k1-prepare.result "$LOCALDIR/k1-prepare-result.txt" 2>/dev/null || true
cp -f /run/r36os-k1-prepare.progress "$LOCALDIR/k1-prepare-progress.txt" 2>/dev/null || true
cp -f /run/r36os-r36update-fat-health.conf "$LOCALDIR/r36update-fat-health.txt" 2>/dev/null || true
cp -f /run/r36os-github-diagnostics.status "$LOCALDIR/github-diagnostics-status.txt" 2>/dev/null || true
cp -f /run/r36os-state-expand.status "$LOCALDIR/state-expand-status.txt" 2>/dev/null || true
cp -f /run/r36os-state-expand.result "$LOCALDIR/state-expand-result.txt" 2>/dev/null || true
cp -f /run/r36os-state-expand.progress "$LOCALDIR/state-expand-progress.txt" 2>/dev/null || true
cp -f /r36update/R36OS-Recovery/state-expand.plan "$LOCALDIR/state-expand-plan.txt" 2>/dev/null || true
cp -f /r36update/R36OS-Recovery/state-expand.pending "$LOCALDIR/state-expand-pending.txt" 2>/dev/null || true
cp -f /r36update/R36OS-Recovery/state-expand.complete "$LOCALDIR/state-expand-complete.txt" 2>/dev/null || true
cp -f /r36update/R36OS-Recovery/state-expand-resize2fs.log "$LOCALDIR/state-expand-resize2fs.log" 2>/dev/null || true
if [ -r /r36update/R36OS-KernelLab/LATEST.conf ]; then
  KLDIR="$(awk -F= '$1=="baseline_dir"{print substr($0,index($0,"=")+1);exit}' /r36update/R36OS-KernelLab/LATEST.conf 2>/dev/null)"
  [ -n "$KLDIR" ] && [ -s "$KLDIR/KERNEL-BASELINE-SHARE.tar.gz" ] && cp -f "$KLDIR/KERNEL-BASELINE-SHARE.tar.gz" "$LOCALDIR/kernel-baseline-share.tar.gz" 2>/dev/null || true
fi
# Capture boot image identity/proof without modifying it during export.
/usr/local/bin/r36os-boot-branding inspect-initramfs >"$LOCALDIR/boot-image-inspection.txt" 2>&1 || true
cp -f /r36state/update/last-failure.conf "$LOCALDIR/update-last-failure.conf" 2>/dev/null || true
cp -f /r36state/update/applied.conf "$LOCALDIR/update-applied.conf" 2>/dev/null || true
printf 'intended_archive=%s\nprimary_export_destination=%s\n' "$ARCHIVE" "$PRIMARY/$ARCHIVE" >>"$LOCALDIR/export-summary.txt" 2>/dev/null || true
progress RUNNING 64 "Building archive" "Compressing the current R36OS diagnostic session"
TMP="$PRIMARY/.${ARCHIVE}.tmp.$$"; FINAL="$PRIMARY/$ARCHIVE"; rm -f "$TMP" 2>/dev/null || true
if ! tar -C "$(dirname "$LOCALDIR")" -czf "$TMP" "$SESSION" 2>"$LOCALDIR/export-tar-error.txt"; then rm -f "$TMP" 2>/dev/null || true; fail_export 74 archive-create-failed; fi
progress RUNNING 75 "Verifying archive" "Checking that the new tar.gz can be read back"
if ! tar -tzf "$TMP" >/dev/null 2>"$LOCALDIR/export-tar-verify-error.txt"; then rm -f "$TMP" 2>/dev/null || true; fail_export 75 archive-integrity-check-failed; fi
BYTES="$(stat -c %s "$TMP" 2>/dev/null || echo 0)"; case "$BYTES" in ''|*[!0-9]*) BYTES=0;; esac
[ "$BYTES" -ge 512 ] || { rm -f "$TMP" 2>/dev/null || true; fail_export 76 archive-too-small; }
SHA="$(sha256sum "$TMP" 2>/dev/null | awk '{print $1}')"; [ -n "$SHA" ] || { rm -f "$TMP" 2>/dev/null || true; fail_export 77 archive-sha256-failed; }
mv -f "$TMP" "$FINAL" 2>/dev/null || { rm -f "$TMP" 2>/dev/null || true; fail_export 78 archive-finalize-failed; }
[ -s "$FINAL" ] || fail_export 79 final-archive-missing
FSHA="$(sha256sum "$FINAL" 2>/dev/null | awk '{print $1}')"; [ "$FSHA" = "$SHA" ] || fail_export 80 final-archive-hash-mismatch
write_marker(){ D="$1"; printf '%s\n' "$ARCHIVE" >"$D/LATEST.TXT" 2>/dev/null || true; printf 'R36OS diagnostics\nNewest verified bundle: %s\nExported: %s\nReason: %s\n' "$ARCHIVE" "$(date -Is 2>/dev/null || date)" "$WHY" >"$D/R36OS-LOGS-HERE.txt" 2>/dev/null || true; rm -f "$D/R36OS-LOG-EXPORT-ERROR.txt" 2>/dev/null || true; }
trim_bundles(){ D="$1"; KEEP="${2:-8}"; N=0; for f in $(ls -1t "$D"/R36OS-Alpha5R*-results-*.tar.gz 2>/dev/null); do N=$((N+1)); [ "$N" -le "$KEEP" ] || rm -f "$f" 2>/dev/null || true; done; }
write_marker "$PRIMARY"; trim_bundles "$PRIMARY" 12
progress RUNNING 86 "Saving copies" "Mirroring the verified archive to other R36OS log locations"
for D in /boot/R36OS-Logs /boot/update/R36OS-Logs /r36update/R36OS-Logs /r36update/update/R36OS-Logs /roms2/r36os/logs; do [ "$D" = "$PRIMARY" ] && continue; ensure_writable_dest "$D" || continue; if cp -f "$FINAL" "$D/$ARCHIVE" 2>/dev/null; then MSHA="$(sha256sum "$D/$ARCHIVE" 2>/dev/null | awk '{print $1}')"; if [ "$MSHA" = "$SHA" ]; then write_marker "$D"; trim_bundles "$D" 8; else echo "mirror_hash_mismatch=$D" >>"$LOCALDIR/export-summary.txt" 2>/dev/null || true; rm -f "$D/$ARCHIVE" 2>/dev/null || true; fi; else echo "mirror_copy_failed=$D" >>"$LOCALDIR/export-summary.txt" 2>/dev/null || true; fi; done
progress RUNNING 96 "Finishing export" "Flushing the verified archive to the SD card"
sync >/dev/null 2>&1 || true
write_status PASS 0 verified "$ARCHIVE" "$FINAL" "$BYTES" "$SHA"
for D in /boot/R36OS-Logs /boot/update/R36OS-Logs /r36update/R36OS-Logs /r36update/update/R36OS-Logs /roms2/r36os/logs; do [ -d "$D" ] || continue; cp -f "$RESULT" "$D/LAST-EXPORT.conf" 2>/dev/null || true; done
printf 'verified_archive=%s\nverified_destination=%s\nverified_bytes=%s\nverified_sha256=%s\n' "$ARCHIVE" "$FINAL" "$BYTES" "$SHA" >>"$LOCALDIR/export-summary.txt" 2>/dev/null || true
progress PASS 100 "Export complete" "$ARCHIVE"
if command -v r36os-github-diagnostics >/dev/null 2>&1; then
  r36os-github-diagnostics capture "export-$WHY" >/dev/null 2>&1 || true
  r36os-github-diagnostics upload-queued >/dev/null 2>&1 &
fi
exit 0
