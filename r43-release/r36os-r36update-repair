#!/bin/bash
# R36OS safe FAT repair for the dedicated R36UPDATE partition.
# R43: target fsck binary is integrity-checked, self-tested, and run in C locale.
# Never run a write-capable fsck on a mounted filesystem and never force/lazy-unmount.
set +e
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
export LC_ALL=C
export LANG=C
unset LANGUAGE

MOUNT="${R36OS_R36UPDATE_MOUNT:-/r36update}"
EXPECTED_DEV="${R36OS_R36UPDATE_DEV:-/dev/mmcblk0p3}"
EXPECTED_UUID="${R36OS_R36UPDATE_UUID:-C49E-0225}"
STATE="${R36OS_STATE_ROOT:-/r36state}"
NEXT="$MOUNT/R36OS-KernelNext"
RESULT=/run/r36os-r36update-repair.result
PROGRESS=/run/r36os-r36update-repair.progress
LOGROOT="$STATE/logs/r36update-repair"
STATIC_FSCK=/usr/local/libexec/r36os/fsck.fat-static
STATIC_FSCK_SHA=/usr/local/libexec/r36os/fsck.fat-static.sha256
CMD="${1:-status}"
FSCK=""
FSCK_SHA=""

progress(){ printf '%s|%s|%s|%s\n' "$1" "$2" "$3" "$4" >"$PROGRESS" 2>/dev/null || true; }
result(){
  st="$1"; code="$2"; detail="$3"; backup="${4:-}"; repair_rc="${5:-}"; verify_rc="${6:-}"
  mkdir -p "$LOGROOT" 2>/dev/null || true
  {
    echo 'format=R36OS_R36UPDATE_REPAIR_RESULT_V2'
    echo "status=$st"
    echo "code=$code"
    echo "detail=$detail"
    echo "device=$EXPECTED_DEV"
    echo "expected_uuid=$EXPECTED_UUID"
    echo "fsck_path=${FSCK:-unknown}"
    echo "fsck_sha256=${FSCK_SHA:-unknown}"
    echo "backup=$backup"
    echo "repair_rc=$repair_rc"
    echo "verify_rc=$verify_rc"
    echo "time=$(date -Is 2>/dev/null || date)"
  } >"$RESULT" 2>/dev/null || true
  cp -f "$RESULT" "$LOGROOT/LAST.conf" 2>/dev/null || true
}
fail(){
  code="$1"; detail="$2"; backup="${3:-}"; repair_rc="${4:-}"; verify_rc="${5:-}"
  progress FAIL 100 "R36UPDATE repair stopped" "$detail"
  result FAIL "$code" "$detail" "$backup" "$repair_rc" "$verify_rc"
  echo "status=FAIL code=$code detail=$detail"
  exit "$code"
}
mounted_source(){ findmnt -rn -o SOURCE --target "$MOUNT" 2>/dev/null | head -1; }
mounted_type(){ findmnt -rn -o FSTYPE --target "$MOUNT" 2>/dev/null | head -1; }
device_uuid(){ blkid -s UUID -o value "$1" 2>/dev/null | head -1; }
choose_fsck(){
  if [ -n "${R36OS_FSCK_FAT:-}" ] && [ -x "$R36OS_FSCK_FAT" ]; then printf '%s\n' "$R36OS_FSCK_FAT"; return 0; fi
  [ -x "$STATIC_FSCK" ] && { printf '%s\n' "$STATIC_FSCK"; return 0; }
  for x in /usr/local/sbin/fsck.fat /usr/sbin/fsck.fat /sbin/fsck.fat /usr/local/sbin/dosfsck /usr/sbin/dosfsck /sbin/dosfsck; do
    [ -x "$x" ] && { printf '%s\n' "$x"; return 0; }
  done
  command -v fsck.fat 2>/dev/null || command -v dosfsck 2>/dev/null
}
armed_marker(){
  find "$NEXT" -maxdepth 1 -type f \( -name 'boot-next.*.once' -o -name 'boot-next.*.consumed' \) -print -quit 2>/dev/null
}
candidate_precheck(){
  K1="$NEXT/K1"
  [ -d "$K1" ] || return 0
  [ -s "$K1/MANIFEST.sha256" ] || return 1
  (cd "$K1" && sha256sum -c MANIFEST.sha256 >/dev/null 2>&1)
}
candidate_identity(){ awk -F= '$1=="candidate_id"{print $2;exit}' "$NEXT/K1/K1.conf" 2>/dev/null; }
mount_readonly_for_verify(){ mkdir -p "$MOUNT" || return 1; mount -t vfat -o ro "$EXPECTED_DEV" "$MOUNT" >/dev/null 2>&1; }
leave_readonly_if_possible(){ mountpoint -q "$MOUNT" 2>/dev/null && return 0; mount_readonly_for_verify >/dev/null 2>&1 || true; }
verify_fsck_tool(){
  FSCK="$1"
  [ -x "$FSCK" ] || return 1
  FSCK_SHA="$(sha256sum "$FSCK" 2>/dev/null | awk '{print $1}')"
  [ -n "$FSCK_SHA" ] || return 1
  if [ "$FSCK" = "$STATIC_FSCK" ]; then
    [ -s "$STATIC_FSCK_SHA" ] || return 2
    (cd "$(dirname "$STATIC_FSCK")" && sha256sum -c "$(basename "$STATIC_FSCK_SHA")" >/dev/null 2>&1) || return 2
  fi
  "$FSCK" --help >/dev/null 2>&1 || return 3
  return 0
}
status(){
  src="$(mounted_source)"; typ="$(mounted_type)"; uuid="$(device_uuid "$EXPECTED_DEV")"; fsck="$(choose_fsck)"
  warn="$(dmesg 2>/dev/null | grep -F 'FAT-fs (mmcblk0p3):' | grep -E 'Volume was not properly unmounted|dirty bit|filesystem has been set read-only' | tail -1)"
  marker="$(armed_marker)"
  fsha="$(sha256sum "$fsck" 2>/dev/null | awk '{print $1}')"
  {
    echo 'format=R36OS_R36UPDATE_REPAIR_STATUS_V2'
    echo "mount=$MOUNT"
    echo "source=${src:-unmounted}"
    echo "fstype=${typ:-unknown}"
    echo "uuid=${uuid:-unknown}"
    echo "fsck_tool=${fsck:-missing}"
    echo "fsck_sha256=${fsha:-unknown}"
    echo "armed_marker=${marker:-none}"
    echo "device_warning=${warn:-none}"
  }
}
repair(){
  rm -f "$RESULT" "$PROGRESS" 2>/dev/null || true
  progress RUNNING 2 "Checking R36UPDATE" "Verifying exact device, UUID and repair prerequisites"

  [ "$(id -u)" = 0 ] || fail 40 not-root
  mountpoint -q "$STATE" 2>/dev/null || fail 41 r36state-not-mounted
  src="$(mounted_source)"; [ "$src" = "$EXPECTED_DEV" ] || fail 42 "unexpected-r36update-source-${src:-none}"
  [ "$(mounted_type)" = vfat ] || fail 43 r36update-not-vfat
  uuid="$(device_uuid "$EXPECTED_DEV")"; [ "$uuid" = "$EXPECTED_UUID" ] || fail 44 "unexpected-r36update-uuid-${uuid:-none}"
  [ -z "$(armed_marker)" ] || fail 45 k1-one-shot-marker-present

  FSCK="$(choose_fsck)"; [ -n "$FSCK" ] && [ -x "$FSCK" ] || fail 46 fat-fsck-tool-missing
  verify_fsck_tool "$FSCK"; tool_rc=$?
  case "$tool_rc" in
    0) ;;
    2) fail 66 fat-fsck-integrity-check-failed ;;
    *) fail 67 "fat-fsck-selftest-failed-$tool_rc" ;;
  esac

  avail_kb="$(df -Pk "$STATE" 2>/dev/null | awk 'NR==2{print $4}')"
  echo "$avail_kb" | grep -Eq '^[0-9]+$' || fail 47 state-free-space-unknown
  [ "$avail_kb" -ge 2097152 ] || fail 48 state-needs-at-least-2gib-free

  progress RUNNING 10 "Validating K1 candidate" "Checking candidate hashes before filesystem repair"
  CID_BEFORE="$(candidate_identity)"
  candidate_precheck || fail 49 k1-candidate-precheck-failed
  MANIFEST_BEFORE="$(sha256sum "$NEXT/K1/MANIFEST.sha256" 2>/dev/null | awk '{print $1}')"

  stamp="$(date +%Y%m%d-%H%M%S 2>/dev/null)"; echo "$stamp" | grep -Eq '^[0-9]{8}-[0-9]{6}$' || stamp="unknown-$$"
  mkdir -p "$LOGROOT" "$STATE/recovery/r36update" || fail 50 recovery-directory-create
  BACKUP="$STATE/recovery/r36update/R36UPDATE-pre-fsck-$stamp.tar"
  LOG="$LOGROOT/repair-$stamp.log"
  {
    echo 'format=R36OS_R36UPDATE_REPAIR_LOG_V2'
    echo "time_start=$(date -Is 2>/dev/null || date)"
    echo "device=$EXPECTED_DEV"
    echo "uuid=$uuid"
    echo "fsck_path=$FSCK"
    echo "fsck_sha256=$FSCK_SHA"
    echo 'locale=C'
    echo 'repair_args=-a'
    echo 'verify_args=-n'
  } >"$LOG"

  progress RUNNING 20 "Backing up R36UPDATE" "Copying all current files to R36STATE before repair"
  tar -C "$MOUNT" -cpf "$BACKUP.tmp" . >>"$LOG" 2>&1 || { rm -f "$BACKUP.tmp"; fail 51 pre-repair-backup-failed; }
  tar -tf "$BACKUP.tmp" >/dev/null 2>>"$LOG" || { rm -f "$BACKUP.tmp"; fail 52 pre-repair-backup-verify-failed; }
  mv -f "$BACKUP.tmp" "$BACKUP" || fail 53 pre-repair-backup-commit-failed
  sha256sum "$BACKUP" >"$BACKUP.sha256" 2>>"$LOG" || fail 54 pre-repair-backup-sha-failed
  sync

  progress RUNNING 48 "Unmounting R36UPDATE" "No forced or lazy unmount is permitted"
  umount "$MOUNT" >>"$LOG" 2>&1 || fail 55 r36update-busy-or-unmount-failed "$BACKUP"
  mountpoint -q "$MOUNT" 2>/dev/null && fail 56 r36update-still-mounted "$BACKUP"

  progress RUNNING 58 "Repairing FAT filesystem" "Running automatic FAT repair on the unmounted exact partition"
  echo '--- fsck repair begin ---' >>"$LOG"
  "$FSCK" -a "$EXPECTED_DEV" >>"$LOG" 2>&1
  REPAIR_RC=$?
  echo "repair_rc=$REPAIR_RC" >>"$LOG"
  echo '--- fsck repair end ---' >>"$LOG"
  case "$REPAIR_RC" in 0|1) ;; *) leave_readonly_if_possible; fail 57 "fat-repair-failed-rc-$REPAIR_RC" "$BACKUP" "$REPAIR_RC";; esac

  progress RUNNING 72 "Verifying FAT filesystem" "Running a separate read-only check before any normal mount"
  echo '--- fsck verify begin ---' >>"$LOG"
  "$FSCK" -n "$EXPECTED_DEV" >>"$LOG" 2>&1
  VERIFY_RC=$?
  echo "verify_rc=$VERIFY_RC" >>"$LOG"
  echo '--- fsck verify end ---' >>"$LOG"
  [ "$VERIFY_RC" -eq 0 ] || { leave_readonly_if_possible; fail 58 "fat-verify-failed-rc-$VERIFY_RC" "$BACKUP" "$REPAIR_RC" "$VERIFY_RC"; }

  progress RUNNING 82 "Verifying candidate read-only" "Mounting R36UPDATE read-only and checking the K1 manifest"
  mount_readonly_for_verify || fail 59 readonly-remount-failed "$BACKUP" "$REPAIR_RC" "$VERIFY_RC"
  [ "$(device_uuid "$EXPECTED_DEV")" = "$EXPECTED_UUID" ] || { umount "$MOUNT" >/dev/null 2>&1; fail 60 uuid-changed-after-repair "$BACKUP" "$REPAIR_RC" "$VERIFY_RC"; }
  CID_AFTER="$(candidate_identity)"
  MANIFEST_AFTER="$(sha256sum "$NEXT/K1/MANIFEST.sha256" 2>/dev/null | awk '{print $1}')"
  [ "$CID_AFTER" = "$CID_BEFORE" ] || { umount "$MOUNT" >/dev/null 2>&1; fail 61 candidate-id-changed "$BACKUP" "$REPAIR_RC" "$VERIFY_RC"; }
  [ "$MANIFEST_AFTER" = "$MANIFEST_BEFORE" ] || { umount "$MOUNT" >/dev/null 2>&1; fail 62 candidate-manifest-changed "$BACKUP" "$REPAIR_RC" "$VERIFY_RC"; }
  candidate_precheck || { umount "$MOUNT" >/dev/null 2>&1; fail 63 k1-candidate-postcheck-failed "$BACKUP" "$REPAIR_RC" "$VERIFY_RC"; }

  progress RUNNING 94 "Final safety unmount" "Leaving R36UPDATE unmounted until the required clean reboot"
  sync
  umount "$MOUNT" >>"$LOG" 2>&1 || fail 64 final-readonly-unmount-failed "$BACKUP" "$REPAIR_RC" "$VERIFY_RC"
  mountpoint -q "$MOUNT" 2>/dev/null && fail 65 final-unmount-not-confirmed "$BACKUP" "$REPAIR_RC" "$VERIFY_RC"

  {
    echo "candidate_id_before=$CID_BEFORE"
    echo "candidate_id_after=$CID_AFTER"
    echo "manifest_before=$MANIFEST_BEFORE"
    echo "manifest_after=$MANIFEST_AFTER"
    echo "backup_sha256=$(awk '{print $1}' "$BACKUP.sha256" 2>/dev/null)"
    echo "fsck_sha256=$FSCK_SHA"
    echo 'reboot_required=yes'
  } >"$LOGROOT/LAST-extra.conf"
  echo "time_end=$(date -Is 2>/dev/null || date)" >>"$LOG"

  progress PASS 100 "R36UPDATE repair verified" "Filesystem and K1 candidate verified; clean reboot is required before Boot Next Once"
  result PASS_REBOOT_REQUIRED 0 repair-verified "$BACKUP" "$REPAIR_RC" "$VERIFY_RC"
  echo "status=PASS_REBOOT_REQUIRED backup=$BACKUP repair_rc=$REPAIR_RC verify_rc=$VERIFY_RC"
  exit 0
}

case "$CMD" in
  status) status;;
  repair) repair;;
  *) echo 'usage: r36os-r36update-repair status|repair' >&2; exit 2;;
esac
