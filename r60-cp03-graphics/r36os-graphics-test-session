#!/bin/bash
# R36OS current build safe Graphics Lab controller.
# Weston owns DRM/GBM/Mali. Test clients are ordinary X11/EGL/GLES2 applications.
# This avoids the R33 kernel Oops caused by direct userspace GBM/EGL on renderD128.
set +e
PROG=/run/r36os-graphics-lab-progress
RESULT=/run/r36os-graphics-lab.result
ROOT=/r36state/logs/graphics-test
HANDREQ=/run/r36os-win/handoff-request
HANDGRANT=/run/r36os-win/handoff-granted
progress(){ printf '%s|%s|%s|%s\n' "$1" "$2" "$3" "$4" >"$PROG" 2>/dev/null || true; }
field(){ awk -F= -v k="$2" '$1==k{v=$2} END{print v}' "$1" 2>/dev/null; }
oops_count(){ dmesg 2>/dev/null | grep -Ec 'Internal error: Oops|Unable to handle kernel NULL pointer|kernel BUG at|BUG:' || true; }
proc_running(){
  p="$1"
  st="$(ps -o stat= -p "$p" 2>/dev/null | tr -d ' ')"
  [ -n "$st" ] || return 1
  case "$st" in Z*|*Z*) return 1;; esac
  return 0
}
TAG="$(/usr/local/bin/r36os-version tag 2>/dev/null)" || { echo FAIL_RELEASE_IDENTITY >"$RESULT"; exit 70; }
TS="$(date +%Y%m%d-%H%M%S 2>/dev/null)"; DIR="$ROOT/\${TAG}-\${TS}"; mkdir -p "$DIR" "$ROOT" 2>/dev/null || true
printf '%s\n' "$DIR" >"$ROOT/LATEST" 2>/dev/null || true; rm -f "$ROOT/LAST.conf" "$RESULT" 2>/dev/null || true
progress RUNNING 3 "Graphics Lab preflight" "Using safe Weston-owned graphics path; direct DRM probe disabled"
/usr/local/bin/r36os-core-integrity graphics-lab >"$DIR/core-integrity.txt" 2>&1 || true
if ! grep -q '^status=PASS$' /run/r36os-core-integrity.conf 2>/dev/null; then echo CORE_MIXED_BUILD >"$RESULT"; progress FAIL 100 "Graphics Lab blocked" "Installed core files do not match one build"; exit 71; fi
. /usr/local/bin/r36os-win-common
ROOTWIN="$(r36_win_root)"; [ -n "$ROOTWIN" ] && [ -f "$ROOTWIN/weston_pkg.squashfs" ] || { echo DISPLAY_BACKEND_MISSING >"$RESULT"; progress FAIL 100 "Graphics Lab blocked" "Weston runtime missing"; exit 72; }
WESTON="$(r36_win_mount "$ROOTWIN")" || { echo DISPLAY_BACKEND_MISSING >"$RESULT"; progress FAIL 100 "Graphics Lab blocked" "Could not mount Weston runtime"; exit 73; }
BOX="$(/usr/local/bin/r36os-runner-manager resolve box64 system 2>/dev/null)"; [ -x "$BOX" ] || BOX="$(/usr/local/bin/r36os-runner-manager resolve box64 stable 2>/dev/null)"
BASE_OOPS="$(oops_count)"; case "$BASE_OOPS" in ''|*[!0-9]*) BASE_OOPS=0;; esac
{
  echo "release=$(/usr/local/bin/r36os-version name 2>/dev/null)"; echo "package=$(/usr/local/bin/r36os-version version 2>/dev/null)"; echo "timestamp=$TS"
  echo 'path=Weston owns DRM/GBM/Mali -> Xwayland -> X11/EGL/GLES2 client'; echo 'direct_drm_probe=DISABLED_R33_KERNEL_OOPS'
  echo "baseline_kernel_oops_count=$BASE_OOPS"; echo "box64=$BOX"; uname -a
  echo '--- dri (inventory only; client does not open it) ---'; ls -l /dev/dri 2>/dev/null || true
} >"$DIR/preflight.txt" 2>&1
TOKEN="$TS-$$"; printf '%s\n' "$TOKEN" >"$HANDREQ"; progress RUNNING 12 "Graphics Lab display handoff" "Waiting for R36OS to release the framebuffer to Weston"
for i in $(seq 1 300); do [ -f "$HANDGRANT" ] && break; sleep .1; done
if [ ! -f "$HANDGRANT" ]; then rm -f "$HANDREQ"; echo HANDOFF_TIMEOUT >"$RESULT"; progress FAIL 100 "Graphics Lab handoff failed" "R36OS did not release the display"; exit 74; fi
rm -f "$HANDREQ" "$HANDGRANT"
LOG="$DIR/weston-session.log"
if ! r36_external_begin "$LOG" "graphics-lab-$TS"; then
  if grep -Eq '(^| )r36os\.kernel_attempt=K1( |$)' /proc/cmdline 2>/dev/null; then
    echo 'input_supervisor_optional=k1-graphics-lab ready=no continuing_without_controller_forwarding=yes' >>"$LOG"
    progress RUNNING 16 "Graphics Lab input" "K1 controller forwarding unavailable; automated graphics probe can continue"
  else
    echo INPUT_SUPERVISOR_FAILED >"$RESULT"
    progress FAIL 100 "Graphics Lab setup failed" "External-session supervisor did not start"
    exit 75
  fi
fi
cleanup(){ r36_external_end >/dev/null 2>&1 || true; /usr/local/bin/r36os-win-session-cleanup graphics-lab >/dev/null 2>&1 || true; printf '%s\n' "$DIR" >"$ROOT/LATEST" 2>/dev/null || true; [ -f "$DIR/LAST.conf" ] && cp -f "$DIR/LAST.conf" "$ROOT/LAST.conf" 2>/dev/null || true; for d in /boot/R36OS-Logs/Live /boot/update/R36OS-Logs/Live; do mkdir -p "$d" 2>/dev/null || continue; cp -f "$DIR/LAST.conf" "$d/GraphicsLab-LAST.conf" 2>/dev/null || true; cp -f "$DIR/native-x11.log" "$d/GraphicsLab-native.log" 2>/dev/null || true; cp -f "$DIR/box64-x11.log" "$d/GraphicsLab-box64.log" 2>/dev/null || true; cp -f "$DIR/weston-session.log" "$d/GraphicsLab-weston.log" 2>/dev/null || true; done; sync >/dev/null 2>&1 || true; }
trap cleanup EXIT INT TERM
progress RUNNING 18 "Starting safe graphics environment" "Weston will own DRM; the test window will show live FPS"
R36_GFX_DIR="$DIR" R36_BOX="$BOX" XDG_RUNTIME_DIR=/run/user/0 setsid "$WESTON/westonwrap.sh" drm gl kiosk system /usr/local/bin/r36os-graphics-test-inner >>"$LOG" 2>&1 & PID=$!
r36_external_register_session "$PID"
START="$(date +%s 2>/dev/null || echo 0)"; FAULT=0; TIMEOUT=0
while proc_running "$PID"; do
  CUR="$(oops_count)"; case "$CUR" in ''|*[!0-9]*) CUR=$BASE_OOPS;; esac
  if [ "$CUR" -gt "$BASE_OOPS" ] 2>/dev/null; then FAULT=1; echo "kernel_fault_detected=1 baseline=$BASE_OOPS current=$CUR" >>"$LOG"; break; fi
  if ps -eo pid=,stat=,comm= 2>/dev/null | awk '$2 ~ /^D/ && ($3 ~ /r36os-gpu|weston|Xwayland/){found=1} END{exit found?0:1}'; then FAULT=1; echo 'd_state_graphics_process=1' >>"$LOG"; break; fi
  NOW="$(date +%s 2>/dev/null || echo 0)"; if [ "$START" -gt 0 ] 2>/dev/null && [ "$NOW" -gt 0 ] 2>/dev/null && [ $((NOW-START)) -ge 42 ]; then TIMEOUT=1; break; fi
  sleep .25
done
if [ "$FAULT" -eq 1 ] || [ "$TIMEOUT" -eq 1 ]; then
  PG="$(ps -o pgid= -p "$PID" 2>/dev/null | tr -d ' ')"; [ "$PG" = "$PID" ] && kill -TERM -- "-$PG" 2>/dev/null || kill -TERM "$PID" 2>/dev/null || true; sleep .4; [ "$PG" = "$PID" ] && kill -KILL -- "-$PG" 2>/dev/null || kill -KILL "$PID" 2>/dev/null || true
  if [ "$FAULT" -eq 1 ]; then printf 'test=R36OS_R34_WESTON_X11_EGL_GLES2\noverall=FAIL\nfailure=KERNEL_DRIVER_FAULT\n' >"$DIR/LAST.conf"; echo KERNEL_DRIVER_FAULT >"$RESULT"; progress FAIL 100 "Graphics Lab stopped" "Kernel/driver fault detected - reboot before more game tests"; exit 76; fi
  printf 'test=R36OS_R34_WESTON_X11_EGL_GLES2\noverall=FAIL\nfailure=SESSION_TIMEOUT\n' >"$DIR/LAST.conf"; echo SESSION_TIMEOUT >"$RESULT"; progress FAIL 100 "Graphics Lab timed out" "Weston/test process did not finish within 42 seconds"; exit 77
fi
# Only wait after zombie-aware proc_running says the child is gone; this avoids an unbounded wait on exited children.
wait "$PID" 2>/dev/null; RC=$?
POST="$(oops_count)"; case "$POST" in ''|*[!0-9]*) POST=$BASE_OOPS;; esac
if [ "$POST" -gt "$BASE_OOPS" ] 2>/dev/null; then printf 'test=R36OS_R34_WESTON_X11_EGL_GLES2\noverall=FAIL\nfailure=KERNEL_DRIVER_FAULT_AFTER_EXIT\n' >"$DIR/LAST.conf"; echo KERNEL_DRIVER_FAULT >"$RESULT"; progress FAIL 100 "Graphics Lab stopped" "Kernel fault appeared during the test"; exit 78; fi
[ -f "$DIR/LAST.conf" ] || printf 'test=R36OS_R34_WESTON_X11_EGL_GLES2\noverall=FAIL\nfailure=NO_INNER_RESULT\nweston_rc=%s\n' "$RC" >"$DIR/LAST.conf"
CREN="$(grep -E 'GL renderer:|GL renderer' "$LOG" 2>/dev/null | tail -1 | sed 's/.*GL renderer:[[:space:]]*//')"; [ -n "$CREN" ] && echo "compositor_renderer=$CREN" >>"$DIR/LAST.conf"
N="$(field "$DIR/LAST.conf" native_x11_status)"; B="$(field "$DIR/LAST.conf" box64_x11_status)"; O="$(field "$DIR/LAST.conf" overall)"
cp -f "$DIR/LAST.conf" "$ROOT/LAST.conf" 2>/dev/null || true
if [ "$O" = PASS ]; then echo PASS >"$RESULT"; progress SUCCESS 100 "Graphics Lab complete" "Native ARM64 and x86-64 Box64 workloads completed safely"; exit 0; fi
echo "FAIL_NATIVE_\${N:-?}_BOX64_\${B:-?}" >"$RESULT"; progress FAIL 100 "Graphics Lab failed" "Native=\${N:-?} Box64=\${B:-?}; see exported logs"; exit 79
