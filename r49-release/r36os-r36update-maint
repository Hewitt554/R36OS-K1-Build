#!/bin/bash
# R36OS Alpha 5R49 controlled R36UPDATE maintenance/staging transaction.
# Long FAT writes use a private mount while /r36update is guarded read-only.
set +e
CMD="${1:-status}"
MOUNT="${R36OS_UPDATE_MOUNT:-/r36update}"
DEV="${R36OS_UPDATE_DEV:-/dev/mmcblk0p3}"
EXPECTED_UUID="${R36OS_EXPECTED_UPDATE_UUID:-C49E-0225}"
STATE="${R36OS_STATE_ROOT:-/r36state}"
PKGROOT="${R36OS_K1_PACKAGED_ROOT:-/opt/r36os/kernel-next}"
SRC="$PKGROOT/K1"
LIVE_NEXT="$MOUNT/R36OS-KernelNext"
META_SRC="$PKGROOT/hook.conf"
POLICY="${R36OS_R36UPDATE_POLICY:-/usr/local/bin/r36os-r36update-policy}"
PREFLIGHT="${R36OS_K1_PREFLIGHT:-/usr/local/bin/r36os-k1-preflight}"
VERSION_HELPER="${R36OS_VERSION_HELPER:-/usr/local/bin/r36os-version}"
CHECKER="${R36OS_FSCK_FAT:-/usr/local/libexec/r36os/fsck.fat-static}"
CHECKER_SHA="$CHECKER.sha256"
FIXTURE="/usr/local/libexec/r36os/fsck-selftest.img.gz"
FIXTURE_SHA="$FIXTURE.sha256"
RESULT="${R36OS_R36UPDATE_MAINT_RESULT:-/run/r36os-r36update-maint.result}"
PROGRESS="${R36OS_K1_PROGRESS_FILE:-/run/r36os-k1-prepare.progress}"
LOGROOT="$STATE/logs/r36update-maint"
RECOVERY="$STATE/recovery/r36update-maint"
PRIVATE="/run/r36os-r36update-rw"
GUARD="/run/r36os-r36update-guard"
VFAT_OPTS=''
PRIVATE_MOUNTED=0
GUARD_MOUNTED=0

progress(){ printf '%s|%s|%s|%s\n' "$1" "$2" "$3" "$4" >"$PROGRESS" 2>/dev/null || true; }
val(){ awk -F= -v k="$2" '$1==k{print substr($0,index($0,"=")+1);exit}' "$1" 2>/dev/null; }
sha(){ sha256sum "$1" 2>/dev/null | awk '{print $1}'; }
mounted(){ mountpoint -q "$MOUNT" 2>/dev/null; }
fat_warning(){ dmesg 2>/dev/null | grep -F 'FAT-fs (mmcblk0p3):' | grep -Ei '(Volume was not properly unmounted|dirty bit|filesystem has been set read-only)' | tail -1; }
verify_hash_file(){
  f="$1"; sf="$2"
  [ -s "$f" ] && [ -s "$sf" ] || return 1
  (cd "$(dirname "$f")" && sha256sum -c "$(basename "$sf")" >/dev/null 2>&1)
}
candidate_regular_tree(){
  root="$1"; [ -d "$root" ] || return 1
  [ -z "$(find "$root" \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit 2>/dev/null)" ]
}
candidate_tree_digest(){
  root="$1"
  (
    cd "$root" || exit 1
    find . -type f -printf '%P\n' 2>/dev/null | LC_ALL=C sort | while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      printf '%s  %s\n' "$(sha256sum "$rel" | awk '{print $1}')" "$rel"
    done
  ) | sha256sum | awk '{print $1}'
}
cleanup_private(){
  if [ "$PRIVATE_MOUNTED" = 1 ] || mountpoint -q "$PRIVATE" 2>/dev/null; then
    sync
    umount "$PRIVATE" >/dev/null 2>&1 || true
    PRIVATE_MOUNTED=0
  fi
  if [ "$GUARD_MOUNTED" = 1 ] || mountpoint -q "$MOUNT" 2>/dev/null; then
    # Only remove /r36update here when it is the guard, never an actual FAT mount.
    src="$(findmnt -n -o SOURCE "$MOUNT" 2>/dev/null | head -1)"
    case "$src" in "$GUARD"|*r36os-r36update-guard*) umount "$MOUNT" >/dev/null 2>&1 || true;; esac
    GUARD_MOUNTED=0
  fi
}
safe_finish(){
  cleanup_private
  "$POLICY" normal >/dev/null 2>&1 || true
}
fail(){
  code="$1"; detail="$2"
  safe_finish
  progress FAIL 100 "R36UPDATE maintenance failed" "$detail (code $code)"
  {
    echo 'status=FAIL'
    echo "code=$code"
    echo "detail=$detail"
    echo "time=$(date -Is 2>/dev/null || date)"
  } >"$RESULT" 2>/dev/null || true
  [ -n "${LOG:-}" ] && printf 'FINAL status=FAIL code=%s detail=%s\n' "$code" "$detail" >>"$LOG" 2>/dev/null || true
  echo "status=FAIL code=$code detail=$detail"
  exit "$code"
}
selftest_checker(){
  verify_hash_file "$CHECKER" "$CHECKER_SHA" || return 90
  verify_hash_file "$FIXTURE" "$FIXTURE_SHA" || return 91
  command -v gzip >/dev/null 2>&1 || return 92
  fixture="/run/r36os-r49-fsck-selftest.img"
  rm -f "$fixture" 2>/dev/null || true
  gzip -dc "$FIXTURE" >"$fixture" 2>/dev/null || { rm -f "$fixture"; return 93; }
  "$CHECKER" -n "$fixture" >/run/r36os-r49-fsck-selftest.out 2>&1
  rc=$?
  rm -f "$fixture" 2>/dev/null || true
  return "$rc"
}
snapshot_small(){
  out="$1"
  mkdir -p "$out" || return 1
  {
    echo 'format=R36OS_R49_R36UPDATE_RECOVERY_EVIDENCE_V1'
    echo "time=$(date -Is 2>/dev/null || date)"
    echo "device=$DEV"
    echo "uuid=$(blkid -s UUID -o value "$DEV" 2>/dev/null)"
    echo "source_candidate_id=$CID"
    echo "source_manifest_sha256=$SRC_MANIFEST_SHA"
    echo "source_tree_digest=$SRC_TREE_DIGEST"
    echo "fat_warning=$(fat_warning)"
    echo "mounts_begin"
    findmnt "$MOUNT" 2>/dev/null || true
    echo "mounts_end"
  } >"$out/summary.conf" || return 1
  cp -f "$SRC/K1.conf" "$out/source-K1.conf" 2>/dev/null || true
  cp -f "$SRC/MANIFEST.sha256" "$out/source-MANIFEST.sha256" 2>/dev/null || true
  cp -f "$META_SRC" "$out/source-hook.conf" 2>/dev/null || true
  if mounted; then
    cp -f "$LIVE_NEXT/K1/K1.conf" "$out/staged-K1.conf" 2>/dev/null || true
    cp -f "$LIVE_NEXT/K1/MANIFEST.sha256" "$out/staged-MANIFEST.sha256" 2>/dev/null || true
    cp -f "$LIVE_NEXT/hook.conf" "$out/staged-hook.conf" 2>/dev/null || true
    find "$MOUNT" -maxdepth 3 -type f -printf '%s|%p\n' 2>/dev/null | LC_ALL=C sort >"$out/fat-file-index.txt" || true
  fi
}
install_guard(){
  mkdir -p "$GUARD" "$PRIVATE" "$MOUNT" || return 1
  mount --bind "$GUARD" "$MOUNT" >/dev/null 2>&1 || return 2
  GUARD_MOUNTED=1
  mount -o remount,bind,ro "$MOUNT" >/dev/null 2>&1 || return 3
  return 0
}
mount_private_rw(){
  mount -t vfat -o rw "$DEV" "$PRIVATE" >/dev/null 2>&1 || return 1
  PRIVATE_MOUNTED=1
  src="$(findmnt -n -o SOURCE "$PRIVATE" 2>/dev/null | head -1 | xargs -r readlink -f)"
  [ "$src" = "$(readlink -f "$DEV")" ] || return 2
  opts="$(findmnt -n -o OPTIONS "$PRIVATE" 2>/dev/null | head -1)"
  case ",$opts," in *,rw,*) return 0;; *) return 3;; esac
}
restore_normal_ro(){
  cleanup_private
  "$POLICY" normal >/dev/null 2>&1
}

status(){
  "$POLICY" status 2>/dev/null || true
  echo "fat_warning=$(fat_warning)"
  echo "source_present=$([ -d "$SRC" ] && echo yes || echo no)"
  if [ -s "$SRC/K1.conf" ]; then
    echo "source_candidate_id=$(val "$SRC/K1.conf" candidate_id)"
    echo "source_manifest_sha256=$(sha "$SRC/MANIFEST.sha256")"
  fi
}

prepare_stage(){
  rm -f "$RESULT" 2>/dev/null || true
  [ "$(id -u)" = 0 ] || fail 40 not-root
  [ "$("$VERSION_HELPER" version 2>/dev/null)" = 0.5.49.0 ] || fail 41 wrong-release
  mountpoint -q "$STATE" 2>/dev/null || fail 42 r36state-not-mounted
  [ -x "$POLICY" ] || fail 43 isolation-policy-missing
  [ -x "$PREFLIGHT" ] || fail 44 k1-preflight-missing
  [ -x "$CHECKER" ] || fail 45 fat-checker-missing
  uuid="$(blkid -s UUID -o value "$DEV" 2>/dev/null | tr 'a-f' 'A-F')"
  [ "$uuid" = "$EXPECTED_UUID" ] || fail 46 r36update-uuid

  progress RUNNING 5 "Maintenance preflight" "Verifying authoritative K1 source"
  "$PREFLIGHT" "$SRC" >/dev/null 2>&1 || fail 47 authoritative-k1-preflight
  candidate_regular_tree "$SRC" || fail 48 authoritative-k1-nonregular
  CID="$(val "$SRC/K1.conf" candidate_id)"; echo "$CID" | grep -Eq '^[0-9a-f]{24}$' || fail 49 candidate-id
  SRC_MANIFEST_SHA="$(sha "$SRC/MANIFEST.sha256")"; [ -n "$SRC_MANIFEST_SHA" ] || fail 50 source-manifest-sha
  SRC_TREE_DIGEST="$(candidate_tree_digest "$SRC")"; [ -n "$SRC_TREE_DIGEST" ] || fail 51 source-tree-digest
  [ -s "$META_SRC" ] && [ "$(val "$META_SRC" candidate_id)" = "$CID" ] || fail 52 packaged-hook-meta

  progress RUNNING 12 "Testing FAT checker" "Validating the packaged checker against a known FAT fixture"
  selftest_checker; SELFTEST_RC=$?
  [ "$SELFTEST_RC" -eq 0 ] || fail 53 "fat-checker-selftest-$SELFTEST_RC"

  "$POLICY" normal >/dev/null 2>&1 || fail 54 policy-readonly
  REQ="$LIVE_NEXT/boot-next.$CID.once"
  CONSUMED="$LIVE_NEXT/boot-next.$CID.consumed"
  GREQ="$LIVE_NEXT/boot-next.once"
  GCON="$LIVE_NEXT/boot-next.consumed"
  [ ! -s "$CONSUMED" ] && [ ! -s "$GCON" ] || fail 55 consumed-marker-present
  STALE_REQUEST=no
  { [ -s "$REQ" ] || [ -s "$GREQ" ]; } && STALE_REQUEST=yes

  stamp="$(date +%Y%m%d-%H%M%S 2>/dev/null)"; echo "$stamp" | grep -Eq '^[0-9]{8}-[0-9]{6}$' || stamp="unknown-$$"
  EVDIR="$RECOVERY/$stamp"; mkdir -p "$LOGROOT" "$RECOVERY" || fail 56 recovery-dir
  snapshot_small "$EVDIR" || fail 57 recovery-evidence
  LOG="$LOGROOT/maintenance-$stamp.log"
  {
    echo 'format=R36OS_R49_R36UPDATE_MAINT_V2'
    echo "time=$(date -Is 2>/dev/null || date)"
    echo "candidate_id=$CID"
    echo "source_manifest_sha256=$SRC_MANIFEST_SHA"
    echo "source_tree_digest=$SRC_TREE_DIGEST"
    echo "stale_request=$STALE_REQUEST"
    echo "checker=$CHECKER"
    echo "checker_sha256=$(sha "$CHECKER")"
    echo 'full_partition_tar_backup=no'
    echo 'recovery_model=reconstructible-k1-plus-small-evidence'
  } >"$LOG"

  progress RUNNING 20 "Isolating R36UPDATE" "Unmounting the real FAT and blocking legacy writers"
  "$POLICY" leave-unmounted >>"$LOG" 2>&1 || fail 58 r36update-unmount
  mounted && fail 59 r36update-still-mounted
  install_guard >>"$LOG" 2>&1 || fail 60 guard-mount-failed

  progress RUNNING 30 "Checking FAT" "Running read-only filesystem check while the device is unmounted"
  "$CHECKER" -n "$DEV" >>"$LOG" 2>&1
  PRECHECK_RC=$?
  case "$PRECHECK_RC" in 0|1) ;; *) fail 61 "fat-precheck-rc-$PRECHECK_RC";; esac

  REPAIR_RC=not-needed
  if [ "$PRECHECK_RC" -eq 1 ]; then
    progress RUNNING 42 "Repairing FAT" "Applying the qualified automatic FAT repair"
    "$CHECKER" -a "$DEV" >>"$LOG" 2>&1
    REPAIR_RC=$?
    case "$REPAIR_RC" in 0|1) ;; *) fail 62 "fat-repair-rc-$REPAIR_RC";; esac
  fi

  progress RUNNING 52 "Verifying FAT" "Rechecking filesystem read-only after repair"
  "$CHECKER" -n "$DEV" >>"$LOG" 2>&1
  VERIFY_RC=$?
  [ "$VERIFY_RC" -eq 0 ] || fail 63 "fat-final-verify-rc-$VERIFY_RC"

  progress RUNNING 60 "Opening private write window" "Only maintenance can see the real FAT read/write"
  mount_private_rw >>"$LOG" 2>&1 || fail 64 private-rw-mount
  WNEXT="$PRIVATE/R36OS-KernelNext"
  WDST="$WNEXT/K1"
  WMETA="$WNEXT/hook.conf"
  WREQ="$WNEXT/boot-next.$CID.once"
  WCON="$WNEXT/boot-next.$CID.consumed"
  WGREQ="$WNEXT/boot-next.once"
  WGCON="$WNEXT/boot-next.consumed"

  [ ! -s "$WCON" ] && [ ! -s "$WGCON" ] || fail 65 consumed-marker-after-repair
  rm -f "$WREQ" "$WREQ.tmp" "$WGREQ" "$WNEXT/boot-next.once.tmp" 2>>"$LOG" || fail 66 stale-request-clear
  sync
  [ ! -e "$WREQ" ] && [ ! -e "$WGREQ" ] || fail 67 stale-request-readback

  progress RUNNING 68 "Verifying staged K1" "Reusing the FAT copy only when it exactly matches /opt"
  mkdir -p "$WNEXT" || fail 68 next-root-create
  REUSE=no
  if [ -d "$WDST" ]; then
    "$PREFLIGHT" "$WDST" >/dev/null 2>&1
    prc=$?
    if [ "$prc" -eq 0 ] && [ "$(sha "$WDST/MANIFEST.sha256")" = "$SRC_MANIFEST_SHA" ]; then
      dtd="$(candidate_tree_digest "$WDST")"
      [ "$dtd" = "$SRC_TREE_DIGEST" ] && REUSE=yes
    fi
  fi

  if [ "$REUSE" != yes ]; then
    progress RUNNING 72 "Restaging K1" "Rebuilding FAT staging from the authoritative /opt candidate"
    rm -rf "$WDST" "$WNEXT"/.K1.r49-stage.* 2>>"$LOG" || fail 69 old-stage-remove
    SRC_KB="$(du -sk "$SRC" 2>/dev/null | awk '{print $1}')"
    AVAIL_KB="$(df -Pk "$PRIVATE" 2>/dev/null | awk 'NR>1{v=$4} END{print v}')"
    echo "$SRC_KB:$AVAIL_KB" | grep -Eq '^[0-9]+:[0-9]+$' || fail 70 stage-space-measure
    NEED_KB=$((SRC_KB + 65536)); [ "$AVAIL_KB" -ge "$NEED_KB" ] || fail 71 stage-space
    TMP="$WNEXT/.K1.r49-stage.$CID.$$"
    mkdir -p "$TMP" || fail 72 stage-dir
    cp -R "$SRC/." "$TMP/" >>"$LOG" 2>&1 || { rm -rf "$TMP"; fail 73 stage-copy; }
    sync
    candidate_regular_tree "$TMP" || { rm -rf "$TMP"; fail 74 stage-nonregular; }
    "$PREFLIGHT" "$TMP" >/dev/null 2>&1 || { rm -rf "$TMP"; fail 75 stage-preflight; }
    [ "$(sha "$TMP/MANIFEST.sha256")" = "$SRC_MANIFEST_SHA" ] || { rm -rf "$TMP"; fail 76 stage-manifest; }
    [ "$(candidate_tree_digest "$TMP")" = "$SRC_TREE_DIGEST" ] || { rm -rf "$TMP"; fail 77 stage-tree-digest; }
    mv "$TMP" "$WDST" || { rm -rf "$TMP"; fail 78 stage-activate; }
    sync
  fi

  "$PREFLIGHT" "$WDST" >/dev/null 2>&1 || fail 79 final-staged-preflight
  [ "$(sha "$WDST/MANIFEST.sha256")" = "$SRC_MANIFEST_SHA" ] || fail 80 final-staged-manifest
  [ "$(candidate_tree_digest "$WDST")" = "$SRC_TREE_DIGEST" ] || fail 81 final-staged-tree

  cp -f "$META_SRC" "$WMETA.tmp" >>"$LOG" 2>&1 || fail 82 hook-meta-copy
  sync
  mv -f "$WMETA.tmp" "$WMETA" || fail 83 hook-meta-activate
  [ "$(sha "$WMETA")" = "$(sha "$META_SRC")" ] || fail 84 hook-meta-readback

  progress RUNNING 82 "Closing private write window" "Returning real R36UPDATE to read-only normal operation"
  sync
  umount "$PRIVATE" >>"$LOG" 2>&1 || fail 85 private-unmount
  PRIVATE_MOUNTED=0
  umount "$MOUNT" >>"$LOG" 2>&1 || fail 86 guard-unmount
  GUARD_MOUNTED=0
  "$POLICY" normal >>"$LOG" 2>&1 || fail 87 restore-readonly-policy

  LIVE_DST="$LIVE_NEXT/K1"
  "$PREFLIGHT" "$LIVE_DST" >/dev/null 2>&1 || fail 88 readonly-staged-preflight
  [ "$(sha "$LIVE_DST/MANIFEST.sha256")" = "$SRC_MANIFEST_SHA" ] || fail 89 readonly-staged-manifest

  {
    echo "precheck_rc=$PRECHECK_RC"
    echo "repair_rc=$REPAIR_RC"
    echo "verify_rc=$VERIFY_RC"
    echo "staged_reused=$REUSE"
    echo 'final_mode=readonly'
  } >>"$LOG"
  progress RUNNING 84 "R36UPDATE ready" "Filesystem clean and exact K1 staging locked read-only"
  {
    echo 'status=PASS_RO_STAGED'
    echo 'code=0'
    echo "candidate_id=$CID"
    echo "precheck_rc=$PRECHECK_RC"
    echo "repair_rc=$REPAIR_RC"
    echo "verify_rc=$VERIFY_RC"
    echo "staged_reused=$REUSE"
    echo "log=$LOG"
  } >"$RESULT"
  echo "status=PASS_RO_STAGED candidate_id=$CID precheck_rc=$PRECHECK_RC repair_rc=$REPAIR_RC verify_rc=$VERIFY_RC staged_reused=$REUSE"
  exit 0
}


open_marker_window(){
  [ "$(id -u)" = 0 ] || { echo 'status=FAIL code=90 detail=not-root'; return 90; }
  [ -b "$DEV" ] || { echo 'status=FAIL code=91 detail=device-missing'; return 91; }
  uuid="$(blkid -s UUID -o value "$DEV" 2>/dev/null | tr 'a-f' 'A-F')"
  [ "$uuid" = "$EXPECTED_UUID" ] || { echo 'status=FAIL code=92 detail=uuid-mismatch'; return 92; }
  "$POLICY" normal >/dev/null 2>&1 || { echo 'status=FAIL code=93 detail=policy-normal'; return 93; }
  "$POLICY" leave-unmounted >/dev/null 2>&1 || { echo 'status=FAIL code=94 detail=public-unmount'; return 94; }
  install_guard >/dev/null 2>&1 || { cleanup_private; "$POLICY" normal >/dev/null 2>&1 || true; echo 'status=FAIL code=95 detail=guard-mount'; return 95; }
  mount_private_rw >/dev/null 2>&1 || { cleanup_private; "$POLICY" normal >/dev/null 2>&1 || true; echo 'status=FAIL code=96 detail=private-rw-mount'; return 96; }
  echo "status=PASS private_mount=$PRIVATE next_root=$PRIVATE/R36OS-KernelNext"
  return 0
}
close_marker_window_unmounted(){
  sync
  if mountpoint -q "$PRIVATE" 2>/dev/null; then
    umount "$PRIVATE" >/dev/null 2>&1 || { echo 'status=FAIL code=97 detail=private-unmount'; return 97; }
  fi
  src="$(findmnt -n -o SOURCE "$MOUNT" 2>/dev/null | head -1)"
  case "$src" in
    "$GUARD"|*r36os-r36update-guard*)
      umount "$MOUNT" >/dev/null 2>&1 || { echo 'status=FAIL code=98 detail=guard-unmount'; return 98; }
      ;;
  esac
  mountpoint -q "$MOUNT" 2>/dev/null && { echo 'status=FAIL code=99 detail=public-still-mounted'; return 99; }
  mountpoint -q "$PRIVATE" 2>/dev/null && { echo 'status=FAIL code=100 detail=private-still-mounted'; return 100; }
  echo 'status=PASS mode=unmounted'
  return 0
}
abort_marker_window_ro(){
  cleanup_private
  "$POLICY" normal >/dev/null 2>&1 || { echo 'status=FAIL code=101 detail=restore-readonly'; return 101; }
  echo 'status=PASS mode=ro'
  return 0
}

case "$CMD" in
  status) status;;
  prepare-stage) prepare_stage;;
  marker-open) open_marker_window;;
  marker-close-unmounted) close_marker_window_unmounted;;
  marker-abort-ro) abort_marker_window_ro;;
  *) echo 'usage: r36os-r36update-maint status|prepare-stage|marker-open|marker-close-unmounted|marker-abort-ro' >&2; exit 2;;
esac
