#!/bin/bash
# R36OS privacy-redacted GitHub diagnostics queue/uploader.
# Raw credentials are never included in diagnostic bundles or logs.
set +e
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

STATE="${R36OS_STATE_ROOT:-/r36state}"
BASE="$STATE/logs/github-diagnostics"
QUEUE="$BASE/queue"
SENT="$BASE/sent"
CFGDIR="$STATE/config"
SECDIR="$STATE/secrets"
CFG="$CFGDIR/github-diagnostics.conf"
TOKEN_FILE="$SECDIR/github-diagnostics.token"
DEVICE_ID_FILE="$CFGDIR/github-diagnostics-device-id"
STATUS=/run/r36os-github-diagnostics.status
API_BASE="${R36OS_GITHUB_DIAGNOSTICS_API_BASE:-https://api.github.com}"
CMD="${1:-status}"
ARG="${2:-manual}"

val(){ awk -F= -v k="$2" '$1==k{print substr($0,index($0,"=")+1);exit}' "$1" 2>/dev/null; }
safe_reason(){ printf '%s' "$1" | tr -c 'A-Za-z0-9._+-' '-' | cut -c1-80; }
write_status(){
  st="$1"; detail="$2"; bundle="${3:-}"; remote="${4:-}"
  mkdir -p "$BASE" 2>/dev/null || true
  {
    echo 'format=R36OS_GITHUB_DIAGNOSTICS_STATUS_V1'
    echo "status=$st"
    echo "detail=$detail"
    echo "bundle=$bundle"
    echo "remote_path=$remote"
    echo "queued=$(find "$QUEUE" -maxdepth 1 -type f -name '*.tar.gz' 2>/dev/null | wc -l | tr -d ' ')"
    echo "sent=$(find "$SENT" -maxdepth 1 -type f -name '*.tar.gz' 2>/dev/null | wc -l | tr -d ' ')"
    echo "time=$(date -Is 2>/dev/null || date)"
  } >"$STATUS" 2>/dev/null || true
}
ensure_dirs(){
  mountpoint -q "$STATE" 2>/dev/null || return 1
  mkdir -p "$QUEUE" "$SENT" "$CFGDIR" "$SECDIR" || return 1
  chmod 0700 "$SECDIR" 2>/dev/null || true
  return 0
}
ensure_device_id(){
  [ -s "$DEVICE_ID_FILE" ] || {
    umask 077
    (head -c 32 /dev/urandom 2>/dev/null || printf '%s-%s' "$(date +%s 2>/dev/null)" "$$") | sha256sum | awk '{print substr($1,1,16)}' >"$DEVICE_ID_FILE.tmp" || return 1
    mv -f "$DEVICE_ID_FILE.tmp" "$DEVICE_ID_FILE" || return 1
    chmod 0600 "$DEVICE_ID_FILE" 2>/dev/null || true
  }
  DEVICE_ID="$(tr -cd '0-9a-f' <"$DEVICE_ID_FILE" | head -c16)"
  [ "${#DEVICE_ID}" -eq 16 ]
}
redact_file(){
  f="$1"; [ -f "$f" ] || return 0
  # Privacy-first redaction. Diagnostic bundles are deliberately smaller than
  # manual exports, so it is better to hide extra network/account text than to
  # risk leaking credentials or identity data to the remote logs repository.
  sed -E -i \
    -e 's/(Authorization:[[:space:]]*).*/\1<REDACTED>/Ig' \
    -e 's/((Bearer|Basic)[[:space:]]+)[A-Za-z0-9._~+\/=:-]+/\1<REDACTED>/Ig' \
    -e 's#https?://[^[:space:]"<>]+#<REDACTED-URL>#Ig' \
    -e 's/github_pat_[A-Za-z0-9_]+/<REDACTED-GITHUB-TOKEN>/g' \
    -e 's/gh[pousr]_[A-Za-z0-9_]+/<REDACTED-GITHUB-TOKEN>/g' \
    -e 's/^([[:space:]]*[A-Za-z0-9_.-]*(password|passwd|passphrase|psk|token|authorization|secret|cookie|api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret)[A-Za-z0-9_.-]*[[:space:]]*[=:][[:space:]]*).*/\1<REDACTED>/Ig' \
    -e 's/^([[:space:]]*"(password|passwd|passphrase|psk|token|authorization|secret|cookie|api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret)"[[:space:]]*:[[:space:]]*).*/\1"<REDACTED>"/Ig' \
    -e 's/^([[:space:]]*(password|passwd|passphrase|psk|token|authorization|secret|cookie|api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret)[[:space:]]+).*/\1<REDACTED>/Ig' \
    -e 's/^([[:space:]]*(ssid|essid|802-11-wireless\.ssid)[[:space:]]*[=:][[:space:]]*).*/\1<REDACTED>/Ig' \
    -e 's/(ESSID:).*/\1<REDACTED>/Ig' \
    -e 's/([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}/<REDACTED-MAC>/g' \
    -e 's/([0-9]{1,3}\.){3}[0-9]{1,3}/<REDACTED-IPV4>/g' \
    -e 's/([[:xdigit:]]{1,4}:){3,}[[:xdigit:]:]{1,39}/<REDACTED-IPV6>/g' \
    -e 's/(^|[[:space:]])[[:xdigit:]]{1,4}::[[:xdigit:]:]*/\1<REDACTED-IPV6>/g' \
    -e 's/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/<REDACTED-EMAIL>/g' \
    "$f" 2>/dev/null || return 1
  return 0
}
privacy_scan_file(){
  f="$1"; [ -f "$f" ] || return 0
  # Fail closed if a recognizable secret/network identifier survives redaction.
  if grep -Eiv '<REDACTED' "$f" 2>/dev/null | grep -Eiq \
    'Authorization:[[:space:]]*(Bearer|Basic)|(^|[^A-Za-z0-9_])(password|passwd|passphrase|psk|token|secret|cookie|api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret|ssid|essid)[[:space:]]*[=:]|github_pat_[A-Za-z0-9_]+|gh[pousr]_[A-Za-z0-9_]+'; then
    return 1
  fi
  if grep -Eq '([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}|([0-9]{1,3}\.){3}[0-9]{1,3}|https?://|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' "$f" 2>/dev/null; then
    return 1
  fi
  return 0
}
import_config(){
  ensure_dirs || return 1
  for root in /boot /r36update /roms2; do
    c="$root/R36OS-GITHUB-DIAGNOSTICS.conf"
    t="$root/R36OS-GITHUB-DIAGNOSTICS.token"
    if [ -s "$c" ]; then
      fmt="$(val "$c" format)"; mode="$(val "$c" mode)"; repo="$(val "$c" repo)"; branch="$(val "$c" branch)"
      [ "$fmt" = R36OS_GITHUB_DIAGNOSTICS_V1 ] || continue
      case "$mode" in automatic|off) ;; *) continue;; esac
      echo "$repo" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' || continue
      echo "${branch:-main}" | grep -Eq '^[A-Za-z0-9._/-]+$' || continue
      umask 077
      {
        echo 'format=R36OS_GITHUB_DIAGNOSTICS_V1'
        echo "mode=$mode"
        echo "repo=$repo"
        echo "branch=${branch:-main}"
      } >"$CFG.tmp" && mv -f "$CFG.tmp" "$CFG"
      chmod 0600 "$CFG" 2>/dev/null || true
    fi
    if [ -s "$t" ]; then
      tok="$(tr -d '\r\n' <"$t")"
      if [ "${#tok}" -ge 20 ] && [ "${#tok}" -le 512 ]; then
        umask 077; printf '%s\n' "$tok" >"$TOKEN_FILE.tmp" && mv -f "$TOKEN_FILE.tmp" "$TOKEN_FILE"
        chmod 0600 "$TOKEN_FILE" 2>/dev/null || true
        # A transport copy must not be left behind on BOOT/R36UPDATE/SD2. If it
        # cannot be removed, discard the imported copy and require the user to
        # fix the transport location before remote upload can become active.
        rm -f "$t" 2>/dev/null || true
        if [ -e "$t" ]; then
          rm -f "$TOKEN_FILE" 2>/dev/null || true
          write_status ERROR token-transport-removal-failed "" "$root"
        fi
      fi
      unset tok
    fi
  done
  return 0
}
capture(){
  reason="$(safe_reason "$1")"; [ -n "$reason" ] || reason=manual
  ensure_dirs || { write_status ERROR state-not-mounted; return 20; }
  ensure_device_id || { write_status ERROR device-id; return 21; }
  stamp="$(date +%Y%m%d-%H%M%S 2>/dev/null)"; echo "$stamp" | grep -Eq '^[0-9]{8}-[0-9]{6}$' || stamp="unknown-$$"
  ver="$(/usr/local/bin/r36os-version version 2>/dev/null)"; [ -n "$ver" ] || ver=unknown
  tag="$(/usr/local/bin/r36os-version tag 2>/dev/null)"; [ -n "$tag" ] || tag=R36OS
  cid="$(awk -F= '$1=="candidate_id"{print $2;exit}' /r36update/R36OS-KernelNext/K1/K1.conf 2>/dev/null)"
  [ -n "$cid" ] || cid="$(awk -F= '$1=="candidate_id"{print $2;exit}' /opt/r36os/kernel-next/K1/K1.conf 2>/dev/null)"
  tmp="$BASE/.capture-$stamp-$$"; rm -rf "$tmp"; mkdir -p "$tmp" || return 22
  {
    echo 'format=R36OS_GITHUB_DIAGNOSTICS_BUNDLE_V1'
    echo "reason=$reason"
    echo "device_id=$DEVICE_ID"
    echo "version=$ver"
    echo "release_tag=$tag"
    echo "kernel_running=$(uname -r 2>/dev/null || echo unknown)"
    echo "candidate_id=${cid:-unknown}"
    echo "failure_code=${R36OS_DIAG_FAILURE_CODE:-}"
    echo "failure_detail=${R36OS_DIAG_FAILURE_DETAIL:-}"
    echo "time=$(date -Is 2>/dev/null || date)"
  } >"$tmp/summary.conf"
  cp -f /etc/r36os-release "$tmp/r36os-release.txt" 2>/dev/null || true
  cp -f /run/r36os-k1-prepare.result "$tmp/k1-prepare-result.txt" 2>/dev/null || true
  cp -f /run/r36os-k1-prepare.progress "$tmp/k1-prepare-progress.txt" 2>/dev/null || true
  cp -f /run/r36os-r36update-fat-health.conf "$tmp/r36update-fat-health.txt" 2>/dev/null || true
  cp -f /run/r36os-kernel-slot.status "$tmp/kernel-slot-status.txt" 2>/dev/null || true
  cp -f /run/r36os-kernel-slot.result "$tmp/kernel-slot-result.txt" 2>/dev/null || true
  cp -f /run/r36os-github-update.status "$tmp/github-update-status.txt" 2>/dev/null || true
  cp -f /r36state/logs/kernel-next/*.conf "$tmp/" 2>/dev/null || true
  if [ -s /r36update/R36OS-KernelNext/K1/K1.conf ]; then cp -f /r36update/R36OS-KernelNext/K1/K1.conf "$tmp/K1.conf"; elif [ -s /opt/r36os/kernel-next/K1/K1.conf ]; then cp -f /opt/r36os/kernel-next/K1/K1.conf "$tmp/K1.conf"; fi

  # R40 general troubleshooting evidence. Potentially noisy files are tail-bounded.
  cp -f /run/r36os-game-launch.result "$tmp/game-launch-result.txt" 2>/dev/null || true
  cp -f /run/r36os-game-session.progress "$tmp/game-session-progress.txt" 2>/dev/null || true
  cp -f /run/r36os-manual-games.tsv "$tmp/game-catalog.tsv" 2>/dev/null || true
  (systemctl --failed --no-pager 2>/dev/null >"$tmp/systemd-failed.txt") || true
  (tail -c 524288 /r36state/logs/r36os-resource.log 2>/dev/null >"$tmp/resource-log-tail.txt") || true

  GSDIR="$(cat /run/r36os-current-game-session 2>/dev/null)"
  [ -d "$GSDIR" ] || GSDIR="$(cat /r36state/logs/game-sessions/LATEST 2>/dev/null)"
  if [ ! -d "$GSDIR" ]; then
    GCONF="$(find /r36state/logs/game-sessions -mindepth 3 -maxdepth 3 -name session.conf -type f -printf '%T@|%p\n' 2>/dev/null | sort -nr | head -1 | cut -d'|' -f2-)"
    [ -n "$GCONF" ] && GSDIR="$(dirname "$GCONF")"
  fi
  GSREAL="$(readlink -f "$GSDIR" 2>/dev/null)"
  case "$GSREAL" in
    /r36state/logs/game-sessions/*)
      mkdir -p "$tmp/latest-game-session"
      for gf in session.conf session.log session.partial.log game-output.log milestones.log launch-results.log performance-summary.txt performance-live.csv linux-preflight.txt weston-session.log; do
        [ -f "$GSREAL/$gf" ] || continue
        tail -c 1048576 "$GSREAL/$gf" >"$tmp/latest-game-session/$gf" 2>/dev/null || true
      done
      printf 'latest_game_session=%s\n' "$(basename "$(dirname "$GSREAL")")/$(basename "$GSREAL")" >>"$tmp/summary.conf"
      ;;
  esac

  OSDIR="$(cat /run/r36os-alpha5-logdir 2>/dev/null)"
  [ -d "$OSDIR" ] || OSDIR="$(find /r36state/logs -maxdepth 1 -type d -name 'alpha5r*-*' -printf '%T@|%p\n' 2>/dev/null | sort -nr | head -1 | cut -d'|' -f2-)"
  OSREAL="$(readlink -f "$OSDIR" 2>/dev/null)"
  case "$OSREAL" in
    /r36state/logs/alpha5r*-*)
      mkdir -p "$tmp/latest-os-session"
      for of in ui.log manual-game-scan.log graphics-test-latest.conf benchmark-suite-latest.txt; do
        [ -f "$OSREAL/$of" ] || continue
        tail -c 1048576 "$OSREAL/$of" >"$tmp/latest-os-session/$of" 2>/dev/null || true
      done
      ;;
  esac

  (dmesg 2>/dev/null | tail -2500 >"$tmp/dmesg-tail.txt") || true
  (findmnt /boot /r36update /r36state /roms2 2>/dev/null >"$tmp/mounts.txt") || true
  (df -hT /boot /r36update /r36state /roms2 2>/dev/null >"$tmp/storage.txt") || true
  (blkid 2>/dev/null >"$tmp/block-identities.txt") || true
  (cat /proc/cmdline 2>/dev/null >"$tmp/cmdline.txt") || true
  (lsmod 2>/dev/null >"$tmp/lsmod.txt") || true
  (journalctl -b -u r36os-kernel-next-health.service --no-pager -n 400 2>/dev/null >"$tmp/kernel-next-health-journal.txt") || true
  # R40 includes nested game/OS directories: redact and privacy-scan recursively.
  while IFS= read -r -d '' f; do
    redact_file "$f" || { rm -rf "$tmp"; write_status ERROR redaction-failed; return 27; }
    privacy_scan_file "$f" || { rm -rf "$tmp"; write_status ERROR privacy-scan-failed; return 28; }
  done < <(find "$tmp" -type f -print0)
  bundle="$QUEUE/R36OS-${tag}-diag-${stamp}-${reason}-${DEVICE_ID}.tar.gz"
  tar -C "$tmp" -czf "$bundle.tmp" . >/dev/null 2>&1 || { rm -rf "$tmp" "$bundle.tmp"; write_status ERROR archive-create; return 23; }
  tar -tzf "$bundle.tmp" >/dev/null 2>&1 || { rm -rf "$tmp" "$bundle.tmp"; write_status ERROR archive-verify; return 24; }
  bytes="$(stat -c %s "$bundle.tmp" 2>/dev/null || echo 0)"
  [ "$bytes" -gt 0 ] && [ "$bytes" -le 8388608 ] || { rm -rf "$tmp" "$bundle.tmp"; write_status ERROR archive-size; return 25; }
  mv -f "$bundle.tmp" "$bundle" || { rm -rf "$tmp"; return 26; }
  sha256sum "$bundle" >"$bundle.sha256" 2>/dev/null || true
  rm -rf "$tmp"
  # Keep queue bounded even while offline/not configured.
  ls -1t "$QUEUE"/*.tar.gz 2>/dev/null | awk 'NR>12' | while IFS= read -r old; do rm -f "$old" "$old.sha256" 2>/dev/null || true; done
  write_status QUEUED "$reason" "$bundle"
  printf '%s\n' "$bundle"
  return 0
}
load_config(){
  import_config >/dev/null 2>&1 || true
  MODE="$(val "$CFG" mode)"; REPO="$(val "$CFG" repo)"; BRANCH="$(val "$CFG" branch)"
  [ -n "$BRANCH" ] || BRANCH=main
  case "$MODE" in automatic|off) ;; *) MODE=off;; esac
  echo "$REPO" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' || REPO=""
  echo "$BRANCH" | grep -Eq '^[A-Za-z0-9._/-]+$' || BRANCH=main
}
verify_private_repo(){
  token="$(tr -d '\r\n' <"$TOKEN_FILE" 2>/dev/null)"; [ "${#token}" -ge 20 ] || { unset token; return 1; }
  resp="$BASE/.repo-check-$$.json"
  code="$(curl -sS -o "$resp" -w '%{http_code}' --connect-timeout 15 --max-time 45 --retry 1 \
    -H "Authorization: Bearer $token" \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    "$API_BASE/repos/$REPO" 2>/dev/null)"
  unset token
  ok=1
  if [ "$code" = 200 ] && grep -Eq '"private"[[:space:]]*:[[:space:]]*true' "$resp" 2>/dev/null; then ok=0; fi
  rm -f "$resp" 2>/dev/null || true
  return "$ok"
}
upload_one(){
  b="$1"; [ -s "$b" ] || return 1
  token="$(tr -d '\r\n' <"$TOKEN_FILE" 2>/dev/null)"; [ "${#token}" -ge 20 ] || { unset token; return 2; }
  ensure_device_id || { unset token; return 3; }
  name="$(basename "$b")"; day="$(date +%Y-%m-%d 2>/dev/null || echo unknown)"
  remote="uploads/$DEVICE_ID/$day/$name"
  req="$BASE/.upload-request-$$.json"; resp="$BASE/.upload-response-$$.json"
  umask 077
  {
    printf '{"message":"R36OS diagnostics %s","branch":"%s","content":"' "$name" "$BRANCH"
    base64 -w 0 "$b" 2>/dev/null
    printf '"}\n'
  } >"$req" || { rm -f "$req"; unset token; return 4; }
  code="$(curl -sS -o "$resp" -w '%{http_code}' --connect-timeout 20 --max-time 180 --retry 2 \
    -X PUT \
    -H "Authorization: Bearer $token" \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    -H 'Content-Type: application/json' \
    --data-binary "@$req" \
    "$API_BASE/repos/$REPO/contents/$remote" 2>/dev/null)"
  unset token; rm -f "$req"
  case "$code" in
    200|201)
      rm -f "$resp"
      mv -f "$b" "$SENT/$name" || return 5
      [ -f "$b.sha256" ] && mv -f "$b.sha256" "$SENT/$name.sha256" 2>/dev/null || true
      REMOTE_PATH="$remote"
      return 0;;
    *)
      # Keep only the HTTP status; GitHub response bodies may contain identifiers.
      printf 'http_status=%s\n' "$code" >"$BASE/last-upload-error.txt" 2>/dev/null || true
      rm -f "$resp"
      return 6;;
  esac
}
upload_queued(){
  ensure_dirs || { write_status ERROR state-not-mounted; return 20; }
  load_config
  count="$(find "$QUEUE" -maxdepth 1 -type f -name '*.tar.gz' 2>/dev/null | wc -l | tr -d ' ')"
  [ "$count" -gt 0 ] || { write_status IDLE no-queued-bundles; return 0; }
  [ "$MODE" = automatic ] || { write_status QUEUED upload-disabled; return 0; }
  [ -n "$REPO" ] || { write_status QUEUED_NOT_CONFIGURED private-repo-not-configured; return 0; }
  [ "$REPO" != 'Hewitt554/R36OS-K1-Build' ] || { write_status QUEUED_NOT_CONFIGURED public-build-repo-forbidden; return 0; }
  [ -s "$TOKEN_FILE" ] || { write_status QUEUED_NOT_CONFIGURED token-not-configured; return 0; }
  command -v curl >/dev/null 2>&1 || { write_status QUEUED curl-unavailable; return 0; }
  verify_private_repo || { write_status QUEUED_NOT_CONFIGURED private-repo-required-or-inaccessible; return 0; }
  sent=0
  for b in $(ls -1tr "$QUEUE"/*.tar.gz 2>/dev/null | head -4); do
    if upload_one "$b"; then sent=$((sent+1)); write_status UPLOADED "sent=$sent" "$SENT/$(basename "$b")" "$REMOTE_PATH"; else write_status QUEUED upload-failed "$b"; break; fi
  done
  ls -1t "$SENT"/*.tar.gz 2>/dev/null | awk 'NR>10' | while IFS= read -r old; do rm -f "$old" "$old.sha256" 2>/dev/null || true; done
  return 0
}
selftest(){
  t="${TMPDIR:-/tmp}/r36os-github-diag-selftest.$$"; mkdir -p "$t" || exit 1
  cat >"$t/sample.txt" <<'S'
ssid=My Home WiFi
ssid="Family Network 5G"
ESSID:"Quoted Network With Spaces"
802-11-wireless.ssid: Cafe WiFi Guest
password=hunter2 with spaces
passwd: "odd value with spaces"
psk = 'correct horse battery staple'
wifi-sec.psk: another secret phrase
token=abc.def.ghi
"access_token": "json-token-value"
client_secret super-secret-cli-value
Authorization: Bearer abcdef.12345
proxy=https://alice:pw@example.invalid/path?q=secret&token=abc
raw_github=github_pat_11AAABBBCCCDDDEEE
legacy_token=ghp_1234567890abcdefghijk
mac=aa:bb:cc:dd:ee:ff
ip=192.168.1.22
ipv6=fe80:1:2:3:4:5:6:7
email=user@example.com
candidate_id=e551eb6598d6da7a8e8320e9
kernel_release=6.12.94-r36os-k1
S
  redact_file "$t/sample.txt" || { rm -rf "$t"; exit 2; }
  privacy_scan_file "$t/sample.txt" || { cat "$t/sample.txt" >&2; rm -rf "$t"; exit 3; }
  grep -q 'candidate_id=e551eb6598d6da7a8e8320e9' "$t/sample.txt" || { rm -rf "$t"; exit 4; }
  grep -q 'kernel_release=6.12.94-r36os-k1' "$t/sample.txt" || { rm -rf "$t"; exit 5; }
  for secret in 'My Home WiFi' 'Family Network 5G' 'Quoted Network With Spaces' 'Cafe WiFi Guest' \
    hunter2 'odd value with spaces' 'correct horse battery staple' 'another secret phrase' \
    abc.def.ghi json-token-value super-secret-cli-value abcdef.12345 alice:pw github_pat_ ghp_ \
    aa:bb:cc:dd:ee:ff 192.168.1.22 fe80:1:2:3:4:5:6:7 user@example.com; do
    grep -Fq "$secret" "$t/sample.txt" && { cat "$t/sample.txt" >&2; rm -rf "$t"; exit 6; }
  done
  rm -rf "$t"; echo 'R36OS_GITHUB_DIAGNOSTICS_SELFTEST=PASS'; exit 0
}

case "$CMD" in
  status) ensure_dirs >/dev/null 2>&1; load_config; write_status STATUS "mode=$MODE repo=${REPO:-not-configured} branch=$BRANCH"; cat "$STATUS" 2>/dev/null;;
  import) import_config; load_config; write_status STATUS "mode=$MODE repo=${REPO:-not-configured} branch=$BRANCH";;
  capture|queue) capture "$ARG";;
  upload-queued) upload_queued;;
  send) capture "$ARG" >/dev/null && upload_queued;;
  selftest) selftest;;
  *) echo 'usage: status|import|capture REASON|upload-queued|send REASON|selftest' >&2; exit 2;;
esac
